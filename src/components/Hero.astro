---
import InteractiveHeroBackground from "./react/InteractiveHeroBackground";
import { ArrowRight, RulerLine, Factory, CheckCircle2 } from "lucide-react";
---

<section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden border-b border-primary/10 bg-surface">
    <img src="/images/brand/vyrobaWhite.png" alt="Vyroba Logo" class="h-10 mix-blend-difference opacity-90" />
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 w-full max-w-[1600px] mx-auto px-6 lg:px-12 pt-32 pb-24 lg:py-0">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      
      <!-- Text Content (Col span 7) -->
      <div class="lg:col-span-8 flex flex-col gap-8 lg:gap-12">
        <!-- Logo Solo en Home para Móvil (Dentro de la página) -->
        <div class="lg:hidden mb-2">
          <img src="/images/brand/vyrobaWhite.png" alt="Vyroba Logo" class="h-10 mix-blend-difference opacity-90 object-contain origin-left" />
        </div>

        <!-- "The Spec Tag" Industrial -->
        <div class="inline-flex w-fit items-center gap-3 px-4 py-2 border border-primary/20 bg-surface-container-low text-primary font-cabinet font-bold uppercase tracking-widest text-xs">
          <span class="w-2 h-2 bg-secondary block"></span>
          División de Fabricación Industrial B2B
        </div>
        
        <h1 class="text-5xl sm:text-6xl md:text-8xl lg:text-[7rem] font-cabinet font-black tracking-tighter leading-[0.9] text-on-surface uppercase">
          Volumen<br/>
          <span class="text-primary block mt-2 lg:mt-4">Industrial.</span>
          <span class="block mt-2 lg:mt-4">Precisión<br/>Artesanal.</span>
        </h1>
        
        <p class="text-lg md:text-xl lg:text-2xl text-on-surface-variant font-satoshi font-medium max-w-2xl leading-relaxed border-l-4 border-secondary pl-6 py-2">
          Somos el aliado estratégico en equipamiento de interiores para desarrolladoras. Cocinas, clósets y puertas en volumen, con precisión milimétrica arquitectónica.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 mt-4">
          <a href="#contacto" class="group relative inline-flex items-center justify-center gap-4 bg-primary text-on-primary px-8 py-5 font-cabinet font-black uppercase tracking-wider text-sm sm:text-base hover:bg-primary-container transition-all duration-150 rounded-none w-full sm:w-auto shadow-[6px_6px_0_0_#8a501c] active:shadow-none active:translate-y-[6px] active:translate-x-[6px]">
            Evaluar viabilidad
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#soluciones" class="inline-flex items-center justify-center gap-4 border-2 border-outline-variant/30 bg-surface/50 backdrop-blur-sm text-primary px-8 py-5 font-cabinet font-bold uppercase tracking-wider text-sm sm:text-base hover:bg-surface-container transition-colors rounded-none w-full sm:w-auto">
            Ver Líneas Estructurales
          </a>
        </div>
      </div>
      
      <!-- Metrics Panel (Col span 5) -->
      <div class="lg:col-span-4 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-1 w-full mt-12 lg:mt-0">
        <!-- Panel 1 -->
        <div class="bg-surface-container-low border border-primary/10 p-6 lg:p-8 flex flex-col justify-center">
          <p class="text-4xl md:text-5xl lg:text-6xl font-cabinet font-black text-primary mb-2">Escala.</p>
          <p class="text-sm lg:text-base text-on-surface-variant font-satoshi font-medium uppercase tracking-widest border-t border-outline-variant/20 pt-4 mt-2">Producción masiva simultánea</p>
        </div>
        <!-- Panel 2 -->
        <div class="bg-primary border border-primary/10 p-6 lg:p-8 flex flex-col justify-center">
          <p class="text-4xl md:text-5xl lg:text-6xl font-cabinet font-black text-on-primary mb-2">
            0.1<span class="text-secondary text-2xl lg:text-4xl">mm</span>
          </p>
          <p class="text-sm lg:text-base text-on-primary/70 font-satoshi font-medium uppercase tracking-widest border-t border-on-primary/20 pt-4 mt-2">Precisión arquitectónica</p>
        </div>
        <!-- Panel 3 -->
        <div class="bg-surface-container p-6 lg:p-8 flex flex-col justify-center">
          <p class="text-4xl md:text-5xl lg:text-6xl font-cabinet font-black text-primary mb-2 flex items-center gap-3">
            100% 
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" class="text-secondary"><path d="M20 6 9 17l-5-5"/></svg>
          </p>
          <p class="text-sm lg:text-base text-on-surface-variant font-satoshi font-medium uppercase tracking-widest border-t border-outline-variant/20 pt-4 mt-2">Garantía de entrega estructural</p>
        </div>
      </div>

    </div>
  </div>
</section>