---
import InteractiveHeroBackground from "./react/InteractiveHeroBackground";
import { ArrowRight, RulerLine, Factory, CheckCircle2 } from "lucide-react";
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden border-b border-white/5">
  <!-- React Animated Background -->
  <InteractiveHeroBackground client:load />

  <!-- Navigation Setup -->
  <header class="absolute top-0 w-full z-50 border-b border-white/10 bg-vyroba-coal/50 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-bold tracking-tighter text-white">VYROBA<span class="text-vyroba-oak">WOOD</span></span>
      </div>
      <nav class="hidden md:flex gap-8 text-sm font-medium text-vyroba-metal">
        <a href="#soluciones" class="hover:text-white transition-colors">Soluciones</a>
        <a href="#el-don" class="hover:text-white transition-colors">El Don</a>
        <a href="#capacidades" class="hover:text-white transition-colors">Capacidades</a>
      </nav>
      <div>
        <a href="#contacto" class="bg-white text-vyroba-coal px-5 py-2.5 rounded-sm font-semibold hover:bg-vyroba-oak hover:text-white transition-colors text-sm">
          Cotizar Proyecto
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full pt-20">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-vyroba-oak text-sm mb-6">
        <span class="w-2 h-2 rounded-full bg-vyroba-oak animate-pulse"></span>
        División de Fabricación Industrial B2B
      </div>
      
      <h1 class="text-6xl md:text-7xl font-extrabold tracking-tight mb-6 leading-[1.1]">
        El volumen industrial no sacrifica el <span class="text-transparent bg-clip-text bg-gradient-to-r from-vyroba-oak to-orange-200">diseño artesanal.</span>
      </h1>
      
      <p class="text-xl text-vyroba-metal mb-10 max-w-2xl leading-relaxed">
        Somos el aliado estratégico en equipamiento de interiores para desarrolladoras y constructoras. Cocinas, clósets y puertas en volumen, con precisión milimétrica y la experiencia del <em class="text-white">"Don"</em>.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 mb-16">
        <a href="#contacto" class="inline-flex items-center justify-center gap-2 bg-vyroba-oak text-white px-8 py-4 rounded-sm font-bold hover:bg-[#c29668] transition-colors">
          Evaluar viabilidad del proyecto
          <ArrowRight className="w-5 h-5" />
        </a>
        <a href="#soluciones" class="inline-flex items-center justify-center gap-2 bg-white/5 border border-white/10 text-white px-8 py-4 rounded-sm font-medium hover:bg-white/10 transition-colors">
          Ver líneas de producción
        </a>
      </div>
      
      <!-- Metrics -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8 pt-8 border-t border-white/10">
        <div>
          <p class="text-3xl font-bold text-white mb-1">Scale</p>
          <p class="text-sm text-vyroba-metal">Producción masiva simultánea</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-white mb-1">0.1<span class="text-vyroba-oak">mm</span></p>
          <p class="text-sm text-vyroba-metal">Precisión industrial</p>
        </div>
        <div class="hidden md:block">
          <p class="text-3xl font-bold text-white mb-1">100%</p>
          <p class="text-sm text-vyroba-metal">Garantía de entrega</p>
        </div>
      </div>
    </div>
  </div>
</section>