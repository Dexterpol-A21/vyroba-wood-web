---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vyroba Wood - Portal B2B">
  <main class="relative">
    
<div class="blueprint-grid"></div>
<!-- Hero Section -->
<section class="relative pt-20 pb-32 px-10 border-b border-outline-variant/20 z-10">
<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
<div class="lg:col-span-8">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-sm tracking-[0.3em] text-secondary font-bold mb-4 uppercase">Fase del Proyecto: Documentación Técnica</div>
<h1 class="font-cabinet font-black text-7xl md:text-9xl text-primary leading-[0.85] tracking-tighter mb-8">
                        ESPECIFICACIONES<br/>TÉCNICAS<br/>2024
                    </h1>
<p class="font-satoshi text-xl text-on-surface-variant max-w-2xl leading-relaxed">
                        Precision engineering for architectural-grade timber applications. Access live inventory data and technical drafting resources for professional procurement.
                    </p>
</div>
<div class="lg:col-span-4 flex flex-col items-start lg:items-end">
<div class="p-6 bg-primary-container text-on-primary w-full max-w-sm">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-xs mb-4 opacity-70 tracking-widest">ESTADO OPERATIVO</div>
<div class="flex items-center gap-3 mb-6">
<span class="w-2 h-2 bg-secondary animate-pulse"></span>
<span class="font-space font-semibold tracking-[0.25em] text-xs text-lg uppercase font-bold tracking-tight">Transmisión Taller: Activa</span>
</div>
<div class="space-y-2 font-space font-semibold tracking-[0.25em] text-xs text-sm uppercase">
<div class="flex justify-between border-b border-white/10 pb-1">
<span>Carga Actual:</span>
<span>84% Capacidad</span>
</div>
<div class="flex justify-between border-b border-white/10 pb-1">
<span>Tiempo de Entrega:</span>
<span>14 Días Hábiles</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Transmisión en Vivo & Technical Layout -->
<section class="px-10 py-24 z-10 relative">
<div class="max-w-7xl mx-auto">
<div class="grid grid-cols-1 md:grid-cols-4 gap-0 border border-primary/20">
<!-- Unit Tracking -->
<div class="md:col-span-3 bg-surface-container-low border-r border-primary/20 p-8">
<div class="flex justify-between items-center mb-12">
<h2 class="font-cabinet font-black text-3xl uppercase tracking-tighter text-primary">Transmisión en Vivo</h2>
<div class="flex gap-4">
<span class="px-3 py-1 bg-surface-container-highest font-space font-semibold tracking-[0.25em] text-xs text-[10px] font-bold tracking-widest text-primary border border-primary/10">DATOS EN TIEMPO REAL</span>
<span class="px-3 py-1 bg-secondary text-on-primary font-space font-semibold tracking-[0.25em] text-xs text-[10px] font-bold tracking-widest border border-primary/10">SINC. LOGÍSTICA</span>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
<!-- Unit Card -->
<div class="border-l-4 border-secondary p-4 bg-white ">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] text-outline mb-2">UNIT_ID: VW-992-ROBLE</div>
<h3 class="font-cabinet font-bold text-lg mb-4">Viga Estructural A12</h3>
<div class="relative h-48 mb-4 overflow-hidden bg-surface-container">
<picture class="contents">
  <source srcset="/images/stitch/stitch_8.avif" type="image/avif" />
  <source srcset="/images/stitch/stitch_8.webp" type="image/webp" />
  <img class="w-full h-full object-cover filter grayscale contrast-125" data-alt="high contrast macro shot of raw heavy timber beams in an industrial workshop setting with technical blueprints nearby" src="/images/stitch/stitch_8.jpg" />
</picture>
<div class="absolute top-2 right-2 bg-primary/90 text-white text-[10px] font-space font-semibold tracking-[0.25em] text-xs px-2 py-1">FRESADO</div>
</div>
<div class="space-y-1 font-space font-semibold tracking-[0.25em] text-xs text-xs uppercase text-on-surface-variant">
<div class="flex justify-between"><span>Humedad:</span><span>12.4%</span></div>
<div class="flex justify-between"><span>Dimension:</span><span>300x300mm</span></div>
</div>
</div>
<!-- Unit Card 2 -->
<div class="border-l-4 border-primary p-4 bg-white ">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] text-outline mb-2">UNIT_ID: VW-401-WAL</div>
<h3 class="font-cabinet font-bold text-lg mb-4">Panel de Fascia X9</h3>
<div class="relative h-48 mb-4 overflow-hidden bg-surface-container">
<picture class="contents">
  <source srcset="/images/stitch/stitch_9.avif" type="image/avif" />
  <source srcset="/images/stitch/stitch_9.webp" type="image/webp" />
  <img class="w-full h-full object-cover filter grayscale brightness-75" data-alt="dramatic lighting on dark walnut wood textures in an architectural model shop environment" src="/images/stitch/stitch_9.jpg" />
</picture>
<div class="absolute top-2 right-2 bg-secondary text-white text-[10px] font-space font-semibold tracking-[0.25em] text-xs px-2 py-1">ESPECIFICACIÓN FINAL</div>
</div>
<div class="space-y-1 font-space font-semibold tracking-[0.25em] text-xs text-xs uppercase text-on-surface-variant">
<div class="flex justify-between"><span>Humedad:</span><span>8.2%</span></div>
<div class="flex justify-between"><span>Dimension:</span><span>1200x2400mm</span></div>
</div>
</div>
<!-- Unit Card 3 -->
<div class="border-l-4 border-primary/20 p-4 bg-white ">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] text-outline mb-2">UNIT_ID: VW-105-CED</div>
<h3 class="font-cabinet font-bold text-lg mb-4">Perfil de Revestimiento V2</h3>
<div class="relative h-48 mb-4 overflow-hidden bg-surface-container">
<picture class="contents">
  <source srcset="/images/stitch/stitch_10.avif" type="image/avif" />
  <source srcset="/images/stitch/stitch_10.webp" type="image/webp" />
  <img class="w-full h-full object-cover filter grayscale opacity-50" data-alt="industrial saw blade slicing through a large cedar log with sparks and sawdust in a wood factory" src="/images/stitch/stitch_10.jpg" />
</picture>
<div class="absolute top-2 right-2 bg-surface-container-highest text-primary text-[10px] font-space font-semibold tracking-[0.25em] text-xs px-2 py-1">PENDIENTE</div>
</div>
<div class="space-y-1 font-space font-semibold tracking-[0.25em] text-xs text-xs uppercase text-on-surface-variant">
<div class="flex justify-between"><span>Humedad:</span><span>--%</span></div>
<div class="flex justify-between"><span>Dimension:</span><span>150x25mm</span></div>
</div>
</div>
</div>
</div>
<!-- Lead Capture Sidebar -->
<div class="bg-primary p-8 text-on-primary">
<div class="mb-12">
<h2 class="font-cabinet font-black text-2xl uppercase tracking-tighter mb-4">Partner with Vyroba Wood</h2>
<p class="font-space font-semibold tracking-[0.25em] text-xs text-xs uppercase tracking-widest text-on-primary-container mb-8">Bulk Procurement &amp; B2B Integration</p>
</div>
<form class="space-y-6">
<div class="space-y-1">
<label class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] uppercase tracking-widest opacity-60">Company Entity</label>
<input class="w-full bg-primary-container border-b border-outline-variant/30 text-white p-3 font-space font-semibold tracking-[0.25em] text-xs text-sm placeholder:opacity-30 focus:border-secondary focus:ring-0" placeholder="ARCH_FIRM_NAME" type="text"/>
</div>
<div class="space-y-1">
<label class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] uppercase tracking-widest opacity-60">Project Scale (m3)</label>
<input class="w-full bg-primary-container border-b border-outline-variant/30 text-white p-3 font-space font-semibold tracking-[0.25em] text-xs text-sm placeholder:opacity-30 focus:border-secondary focus:ring-0" placeholder="0.00" type="number"/>
</div>
<div class="space-y-1">
<label class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] uppercase tracking-widest opacity-60">Email Access</label>
<input class="w-full bg-primary-container border-b border-outline-variant/30 text-white p-3 font-space font-semibold tracking-[0.25em] text-xs text-sm placeholder:opacity-30 focus:border-secondary focus:ring-0" placeholder="OFFICE@VYROBA.COM" type="email"/>
</div>
<div class="pt-6">
<button class="w-full bg-secondary hover:bg-on-secondary-container transition-all py-4 font-cabinet font-black uppercase tracking-tighter text-on-primary text-sm" type="submit">
                                    Request Technical Access
                                </button>
</div>
</form>
<div class="mt-12 pt-8 border-t border-white/10">
<div class="flex items-center gap-4 text-xs font-space font-semibold tracking-[0.25em] text-xs opacity-60">
<span class="material-symbols-outlined text-sm">verified</span>
<span>CERTIFIED ISO-9001 PRECISION</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Resource Library (Bento Style) -->
<section class="px-10 py-24 bg-surface-container-high relative overflow-hidden">
<div class="max-w-7xl mx-auto z-10 relative">
<div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
<div>
<h2 class="font-cabinet font-black text-5xl uppercase tracking-tighter text-primary mb-4">Resource Library</h2>
<p class="font-satoshi text-on-surface-variant max-w-xl">Download BIM objects, CAD details, and technical datasheets for seamless integration into your architectural Revit or AutoCAD workflows.</p>
</div>
<div class="flex gap-4">
<button class="bg-white border border-primary/20 px-6 py-2 font-space font-semibold tracking-[0.25em] text-xs font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-all">All Files</button>
<button class="bg-white border border-primary/20 px-6 py-2 font-space font-semibold tracking-[0.25em] text-xs font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-all">CAD (DWG)</button>
<button class="bg-white border border-primary/20 px-6 py-2 font-space font-semibold tracking-[0.25em] text-xs font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-all">BIM (RVT)</button>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-12 gap-1 auto-rows-[120px]">
<!-- Large Feature Resource -->
<div class="md:col-span-6 lg:col-span-8 lg:row-span-4 bg-primary p-12 flex flex-col justify-between text-on-primary border border-white/5">
<div>
<span class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] tracking-[0.4em] uppercase opacity-50 mb-6 block">MASTER SPECIFICATION</span>
<h3 class="font-cabinet font-black text-4xl lg:text-6xl uppercase tracking-tighter leading-none mb-8">Structural Oak<br/>Jointing Details</h3>
</div>
<div class="flex items-center justify-between">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-xs opacity-60">VER 4.2 // PDF + DWG // 142MB</div>
<button class="flex items-center gap-4 font-cabinet font-black uppercase text-secondary hover:text-secondary-container transition-colors">
<span class="text-xl">Download Package</span>
<span class="material-symbols-outlined">download</span>
</button>
</div>
</div>
<!-- Small Resource 1 -->
<div class="md:col-span-3 lg:col-span-4 lg:row-span-2 bg-white p-6 border border-primary/10 flex flex-col justify-between group cursor-pointer hover:bg-surface-container-low transition-colors">
<div class="material-symbols-outlined text-primary text-3xl">architecture</div>
<div>
<h4 class="font-cabinet font-bold text-lg uppercase tracking-tight">Wall Cladding Revit Family</h4>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] text-outline mt-2">BIM / REVIT 2024</div>
</div>
</div>
<!-- Small Resource 2 -->
<div class="md:col-span-3 lg:col-span-4 lg:row-span-2 bg-secondary p-6 text-white flex flex-col justify-between group cursor-pointer">
<div class="material-symbols-outlined text-4xl">inventory_2</div>
<div>
<h4 class="font-cabinet font-black text-lg uppercase tracking-tight">Timber Humedad Indices</h4>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] opacity-70 mt-2">DATASET / CSV / EXCEL</div>
</div>
</div>
<!-- Small Resource 3 -->
<div class="md:col-span-3 lg:col-span-4 lg:row-span-2 bg-surface-container-highest p-6 border border-primary/10 flex flex-col justify-between group cursor-pointer hover:bg-white transition-colors">
<div class="material-symbols-outlined text-primary text-3xl">layers</div>
<div>
<h4 class="font-cabinet font-bold text-lg uppercase tracking-tight">Veneer Texture Maps</h4>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-[10px] text-outline mt-2">ASSET / 8K TIF</div>
</div>
</div>
</div>
</div>
</section>
<!-- Technical Partnership CTA -->
<section class="py-32 px-10 border-t border-primary/10">
<div class="max-w-4xl mx-auto text-center">
<div class="font-space font-semibold tracking-[0.25em] text-xs text-sm tracking-[0.5em] text-secondary font-black mb-12 uppercase">Precisión de Ingeniería. Architectural Soul.</div>
<h2 class="font-cabinet font-black text-5xl md:text-7xl uppercase tracking-tighter text-primary mb-12 leading-[0.9]">
                    Procure with Absolute Confidence.
                </h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-left border-y border-primary/10 py-12 mb-12">
<div>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-xs font-bold uppercase mb-2">01 // SOURCE</div>
<p class="font-satoshi text-sm text-on-surface-variant">Sustainably harvested timber from managed European forests, serialized upon felling.</p>
</div>
<div>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-xs font-bold uppercase mb-2">02 // PROCESS</div>
<p class="font-satoshi text-sm text-on-surface-variant">CNC milling and kiln drying monitored by neural-network moisture sensors.</p>
</div>
<div>
<div class="font-space font-semibold tracking-[0.25em] text-xs text-xs font-bold uppercase mb-2">03 // DELIVER</div>
<p class="font-satoshi text-sm text-on-surface-variant">Just-in-time delivery logistics integrated directly with your construction schedule.</p>
</div>
</div>
<button class="bg-primary text-on-primary px-12 py-6 font-cabinet font-black text-2xl uppercase tracking-tighter hover:bg-primary-container transition-all">
                    Initiate Procurement Phase
                </button>
</div>
</section>

  </main>
</Layout>
