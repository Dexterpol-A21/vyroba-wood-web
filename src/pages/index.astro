  <script>
    document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    // Muestra el contenedor padre
                    entry.target.classList.remove('translate-y-32', 'opacity-0');
                    observer.unobserve(entry.target);
                    
                    // Anima el interior (el salto de boton) "uno a la vez"
                    const card = entry.target.querySelector('.dynamic-card');
                    if (card) {
                        // El retraso se basa en el numero de elemento (delay escalonado ya definido en el padre mas 500ms al llegar)
                        setTimeout(() => {
                            card.classList.remove('top-0', 'shadow-none');
                            card.classList.add('-top-[0.4em]', card.getAttribute('data-shadow'));
                        }, 500); // Darle tiempo a la tarjeta 1 de aparecer
                    }
                }
            });
        }, { threshold: 0.2 });

        document.querySelectorAll('.reveal-card').forEach(card => observer.observe(card));
    });
  </script>
