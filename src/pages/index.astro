---
import Layout from '../layouts/Layout.astro';
import DraftingGrid from '../components/grids/DraftingGrid';
import CNCGrid from '../components/grids/CNCGrid';
import BlueprintGrid from '../components/grids/BlueprintGrid';
---

<Layout 
	title="Vyroba Wood | Diseño y Calidad"
	description="Fabricación de cocinas, clósets y puertas con precisión de ingeniería. Fusionamos la tradición del trabajo en madera con tecnología de manufactura avanzada B2B."
	keywords="vyroba wood, mobiliario a escala industrial, carpintería b2b, manufactura en madera, cocinas integrales, closets a medida, diseño industrial"
>
  <main class="relative">
    <!-- Logo Móvil Superior (No fijo, fondo azul) -->
    <div class="block lg:hidden w-full h-[80px] bg-primary z-[90] px-6 flex items-center justify-start">
      <a href="/" aria-label="Vyroba Wood Inicio" class="flex items-center">
        <img src="/images/brand/vyrobaWhite.png" alt="Vyroba Wood" class="h-12 w-auto object-contain" />
      </a>
    </div>

    <!-- Grid Global Fijo -->
    <DraftingGrid client:load />


<!-- Hero: THE ENGINEERED ORGANIC -->
<section class="relative min-h-[calc(100vh-80px)] lg:min-h-screen pt-4 lg:pt-[130px] pb-32 lg:pb-12 px-6 md:px-12 flex flex-col justify-between overflow-hidden border-b border-outline-variant/20 w-full mb-0">

<div class="relative w-full z-10 pointer-events-auto flex flex-col justify-center h-full flex-grow pt-4 lg:pt-0">
        <div class="flex flex-col items-start w-full lg:w-7/12 mt-auto">
            <span class="font-bold tracking-[0.2em] text-xs text-secondary uppercase block mb-6">Vyroba Wood // Diseño y Calidad en Cada Mueble</span>

            <h1 class="text-[clamp(3.5rem,7.5vw,10rem)] font-black leading-[0.80] tracking-tighter text-primary uppercase font-cabinet w-full text-left break-words m-0 p-0 transform -translate-y-2 mb-8 xl:mb-10">
                MOBILIARIO<br/>
                ÚNICO Y<br/>
                FUNCIONAL
            </h1>

            <p class="text-lg lg:text-[1.3rem] text-on-surface-variant font-medium leading-[1.35] text-left max-w-[55ch] mb-10 lg:mb-12">
                <strong>Transformamos ideas.</strong> Combinamos artesanía tradicional y técnicas innovadoras para ofrecer muebles personalizados de la más alta calidad. Desde mobiliario para el hogar hasta soluciones comerciales, cada pieza refleja dedicación al diseño empleando <strong class="text-primary font-black">materiales seleccionados y tecnología avanzada.</strong>
            </p>

            <!-- Space Filler: Key Metrics (Architectural Minimalist) -->
            <div class="hidden lg:flex flex-wrap items-center gap-4 xl:gap-6">
                <div class="flex flex-col">
                    <span class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-secondary mb-1">01 // Enfoque</span>
                    <span class="text-[0.85rem] text-primary font-bold tracking-wide">Muebles Hechos a Medida</span>
                </div>
                <div class="w-[1px] h-8 bg-primary/20"></div>
                <div class="flex flex-col">
                    <span class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-secondary mb-1">02 // Metodología</span>
                    <span class="text-[0.85rem] text-primary font-bold tracking-wide">Artesanía & Innovación</span>
                </div>
                <div class="w-[1px] h-8 bg-primary/20"></div>
                <div class="flex flex-col">
                    <span class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-secondary mb-1">03 // Cumplimiento</span>
                    <span class="text-[0.85rem] text-primary font-bold tracking-wide">Entregas Just-in-Time</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Image and Buttons -->
        <div class="flex flex-col items-start lg:items-center w-full lg:w-7/12 mt-12 lg:mt-0 relative z-20 justify-center">
            
            <!-- Floating Image Box with Slow Gallery CSS -->
            <style>
                /* Drag & Swipe Slider Styles */
                .gallery-slider {
                    display: block;
                    position: relative;
                }
                
                .gallery-card {
                    position: absolute;
                    top: 0; left: 0;
                    width: 100%; height: 100%;
                    user-select: none;
                    transform-origin: bottom center;
                    backface-visibility: hidden;
                    box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
                    will-change: transform, opacity;
                }

                .gallery-img-sw {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: grayscale(1) contrast(1.25);
                    transition: transform 0.8s ease-out, filter 0.8s ease-out;  
                    pointer-events: none; /* Helps with dragging */
                }

                .hero-image-box {
                    transition: transform 0.3s ease, box-shadow 0.3s ease;
                }

                .hero-image-box:hover {
                    /* Sale un poco (levanta) antes de hacer click */
                    transform: translate(-4px, -4px);
                    box-shadow: 16px 16px 0 0 #162839 !important;
                }

                .hero-image-box:active {
                    /* Se hunde completamente como interruptor pesado */
                    transform: translate(12px, 12px);
                    box-shadow: 0px 0px 0 0 #162839 !important;
                }

                .hero-image-box:hover .gallery-img-sw {
                    filter: grayscale(0) contrast(1.1);
                    transform: scale(1.05);
                }

                .gallery-label {
                    position: absolute;
                    bottom: -1rem;
                    left: -1rem;
                    opacity: 0;
                    transition: opacity 0.3s ease;
                    z-index: 30;
                    pointer-events: none;
                }
                .gallery-label.active {
                    opacity: 1;
                }

                /* Active Grabbing state cursor */
                .gallery-slider.grabbing {
                    cursor: grabbing;
                    scroll-snap-type: none; /* Remove snap behavior while dragging */
                    scroll-behavior: auto; /* Remove smooth scroll while dragging */
                }
                .gallery-slider.grabbing .gallery-img-sw {
                    transform: scale(1); /* remove scale when dragging */
                }
            </style>

            <div class="w-full max-w-[550px] xl:max-w-[750px] aspect-[4/3] xl:aspect-[16/9] border border-primary relative shadow-[12px_12px_0_0_#162839] bg-primary mb-8 hero-image-box cursor-grab overflow-visible" id="hero-slider-wrap" style="perspective: 1200px;">

                <!-- Inner container to mask overflowing gallery images -->     
                <div class="absolute inset-0 w-full h-full" style="transform-style: preserve-3d;">    
                    <!-- Overlay Grid lines for blueprint effect -->
                    <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.1)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-20 mix-blend-multiply"></div>

                    <!-- Draggable / Scrollable Gallery Images -->
                    <div class="gallery-slider w-full h-full" id="hero-slider">
                        <div class="gallery-card"><img src="/images/Hero5full%20kitchen%20.png" alt="Cocina Residencial Final" class="gallery-img-sw" /></div>
                        <div class="gallery-card"><img src="/images/Hero1Madera.png" alt="Detalle Arquitectónico Madera" class="gallery-img-sw" /></div>
                        <div class="gallery-card"><img src="/images/Hero2CNC%20.png" alt="Maquinaria Industrial" class="gallery-img-sw" /></div>
                        <div class="gallery-card"><img src="/images/Hero3VOLUMEN%20.png" alt="Escala de Producción Arquitectónica" class="gallery-img-sw" /></div>
                        <div class="gallery-card"><img src="/images/Hero4Cocinacost.png" alt="Control de Costos Producción" class="gallery-img-sw" /></div>
                    </div>
                </div>

                <!-- Dynamic Tech spec labels pinned to image -->
                <div class="gallery-label label-track active bg-surface border border-primary px-4 py-2 text-primary text-[0.65rem] font-bold tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                    FIG. 01 // PROYECTO INTEGRAL
                </div>
                <div class="gallery-label label-track bg-surface border border-primary px-4 py-2 text-primary text-[0.65rem] font-bold tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                    FIG. 02 // TEXTURA DE MATERIAL
                </div>
                <div class="gallery-label label-track bg-surface border border-primary px-4 py-2 text-primary text-[0.65rem] font-bold tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                    FIG. 03 // MECANIZADO INDUSTRIAL
                </div>
                <div class="gallery-label label-track bg-surface border border-primary px-4 py-2 text-primary text-[0.65rem] font-bold tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                    FIG. 04 // ALTO VOLUMEN
                </div>
                <div class="gallery-label label-track bg-surface border border-primary px-4 py-2 text-primary text-[0.65rem] font-bold tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                    FIG. 05 // CONTROL DE COSTOS
                </div>
            </div>

            <!-- CTA Buttons Box -->
            <div class="w-full max-w-[550px] xl:max-w-[750px] flex flex-col sm:flex-row gap-4 mt-6">
                <!-- Action Button 1 -->
                <a href="#contacto" class="cursor-pointer bg-secondary border border-secondary text-surface px-6 py-5 font-black uppercase tracking-widest text-[0.70rem] shadow-[4px_4px_0_0_#1a1c1c] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#1a1c1c] active:shadow-none active:translate-y-[4px] active:translate-x-[4px] transition-all duration-150 inline-flex items-center justify-center w-full whitespace-nowrap truncate">
                    Cotizar Desarrollo
                </a>
                <!-- Action Button 2 -->
                <a href="#lineas-de-produccion" class="cursor-pointer bg-surface border border-primary text-primary px-6 py-5 font-black uppercase tracking-widest text-[0.70rem] shadow-[4px_4px_0_0_#162839] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#162839] active:shadow-none active:translate-y-[4px] active:translate-x-[4px] transition-all duration-150 inline-flex items-center justify-center w-full whitespace-nowrap truncate">
                    Explorar Proceso
                </a>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const stackWrap = document.getElementById('hero-slider-wrap');
                    let cards = Array.from(document.querySelectorAll('.gallery-card'));
                    const labels = document.querySelectorAll('.label-track');
                    
                    let currentIndex = 0;
                    
                    function updateStack() {
                        cards.forEach((card, index) => {
                            if (index === 0) {
                                card.style.zIndex = 50;
                                card.style.transform = `translate(0px, 0px)`;
                                card.style.opacity = 1;
                            } else {
                                card.style.zIndex = 50 - index;
                                // Brutalist corner offset
                                card.style.transform = `translate(${index * 8}px, ${index * 8}px)`;
                                card.style.opacity = 1;
                            }
                        });
                        
                        labels.forEach((l, i) => {
                            if(i === currentIndex) l.classList.add('active');
                            else l.classList.remove('active');
                        });
                    }

                    function swipeOutTopCard(direction) {
                        const topCard = cards.shift();
                        const dirMult = direction === 'right' ? 1 : -1;
                        
                        topCard.style.transition = 'transform 0.4s ease-in, opacity 0.4s ease-in';
                        topCard.style.transform = `translateX(${dirMult * 120}%) rotate(${dirMult * 15}deg)`;
                        topCard.style.opacity = 0;
                        
                        currentIndex = (currentIndex + 1) % labels.length;
                        
                        setTimeout(() => {
                            topCard.style.transition = 'none';
                            cards.push(topCard);
                            updateStack();
                            setTimeout(() => {
                                topCard.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
                            }, 50);
                        }, 400);
                        
                        updateStack();
                    }

                    function swipeInBottomCard() {
                        const bottomCard = cards.pop();
                        bottomCard.style.transition = 'none';
                        bottomCard.style.transform = 'translateX(-120%) rotate(-15deg)';
                        bottomCard.style.opacity = 0;
                        cards.unshift(bottomCard);
                        
                        currentIndex = (currentIndex - 1 + labels.length) % labels.length;
                        
                        // Force reflow
                        void bottomCard.offsetWidth;
                        
                        bottomCard.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
                        updateStack();
                    }

                    // Drag Logic
                    let startX = 0;
                    let isDragging = false;
                    let topCardNode = null;

                    stackWrap.addEventListener('mousedown', (e) => {
                        isDragging = true;
                        startX = e.pageX;
                        topCardNode = cards[0];
                        topCardNode.style.transition = 'none';
                        stackWrap.style.cursor = 'grabbing';
                    });
                    
                    window.addEventListener('mousemove', (e) => {
                        if(!isDragging || !topCardNode) return;
                        e.preventDefault();
                        const x = e.pageX - startX;
                        const rotate = x * 0.05;
                        topCardNode.style.transform = `translateX(${x}px) rotate(${rotate}deg)`;
                    });

                    window.addEventListener('mouseup', (e) => {
                        if(!isDragging || !topCardNode) return;
                        isDragging = false;
                        stackWrap.style.cursor = 'grab';
                        
                        const diffX = e.pageX - startX;
                        if(diffX < -60) {
                            swipeOutTopCard('left');
                        } else if(diffX > 60) {
                            swipeOutTopCard('right');
                        } else {
                            topCardNode.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
                            updateStack();
                        }
                        topCardNode = null;
                    });
                    
                    window.addEventListener('mouseleave', () => {
                        if(isDragging && topCardNode) {
                            isDragging = false;
                            stackWrap.style.cursor = 'grab';
                            topCardNode.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
                            updateStack();
                            topCardNode = null;
                        }
                    });

                    // Auto-play Logic
                    let autoPlayTimer;
                    const AUTO_PLAY_INTERVAL = 8000; // 8 segundos para que cambien más lento

                    function startAutoPlay() {
                        stopAutoPlay();
                        autoPlayTimer = setInterval(() => {
                            if (!isDragging) {
                                swipeOutTopCard('right');
                            }
                        }, AUTO_PLAY_INTERVAL);
                    }

                    function stopAutoPlay() {
                        if (autoPlayTimer) clearInterval(autoPlayTimer);
                    }

                    // Pausar automático si el usuario pone el mouse encima
                    stackWrap.addEventListener('mouseenter', stopAutoPlay);
                    stackWrap.addEventListener('mouseleave', startAutoPlay);

                    // Initialize
                    updateStack();
                    startAutoPlay();
                });                </script>
            </div>
        </div>
    </div>
</section>

<!-- SEGUNDA SECCION: MÓDULOS & DEPARTAMENTO -->
<section id="lineas-de-produccion" class="w-full relative min-h-screen pt-40 md:pt-48 bg-surface border-t border-surface-dim">
    <div class="px-6 md:px-12 w-full">
        <!-- Título -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end mb-16 md:mb-32">
            <div class="col-span-1 md:col-span-6">
                <span class="inline-block px-3 py-1 bg-surface border border-primary/20 text-[0.65rem] font-bold text-primary mb-8 tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839] whitespace-nowrap">
                    01 // ESTRUCTURAS MODULARES
                </span>
                <h3 class="text-5xl md:text-[5vw] font-black uppercase tracking-tighter leading-[0.9] text-primary font-cabinet">
                    Equipamiento<br/>para Desarrollos
                </h3>
            </div>
            <div class="col-span-1 md:col-span-6">
                <p class="text-xl md:text-2xl text-on-surface-variant font-medium leading-[1.3]">
                    Manufacturamos y ensamblamos mobiliario fijo a gran escala para equipar torres residenciales, hotelería y complejos corporativos. Un solo proveedor, calidad estandarizada en cientos de unidades.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full pt-8 p-[0.4em]">
            <!-- Line 1: Cocinas -->
            <div class="w-full rounded-sm transform transition-all duration-1000 ease-out reveal-card translate-y-32 opacity-0">
                <a href="/cocinas" data-shadow="shadow-[0_0.4em_0.1em_0.019em_#8a501c]" class="dynamic-card relative top-0 block h-full bg-[#8a501c]/5 hover:bg-[#8a501c]/10 p-10 border border-outline-variant/30 shadow-none transition-all duration-[500ms] group cursor-pointer flex flex-col justify-between hover:translate-y-[0.4em] hover:shadow-none hover:border-[#8a501c]/50">
                    <div>
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-5xl font-black text-outline/30 group-hover:text-[#8a501c] transition-colors block">01</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="w-10 h-10 text-outline/40 group-hover:text-[#8a501c] transition-colors">
                            <!-- Gabinetes superiores (Alacenas) -->
                            <rect x="4" y="3" width="16" height="7"></rect>
                            <line x1="12" y1="3" x2="12" y2="10"></line>
                            <!-- Tiradores superiores -->
                            <line x1="10" y1="8" x2="10" y2="9"></line>
                            <line x1="14" y1="8" x2="14" y2="9"></line>
                            
                            <!-- Cubierta / Encimera que sobresale -->
                            <rect x="2" y="14" width="20" height="2"></rect>
                            
                            <!-- Gabinetes base inferiores -->
                            <rect x="4" y="16" width="16" height="6"></rect>
                            <line x1="12" y1="16" x2="12" y2="22"></line>
                            <!-- Tiradores inferiores -->
                            <line x1="10" y1="17" x2="10" y2="18"></line>
                            <line x1="14" y1="17" x2="14" y2="18"></line>
                        </svg>
                    </div>
                    <h4 class="text-2xl font-black uppercase mb-4 text-primary group-hover:text-[#8a501c] transition-colors">Cocinas Integrales</h4>
                    <p class="text-on-surface-variant font-medium leading-relaxed mb-8">
                        Producción en serie de módulos de cocina. Desde gabinetes y alacenas hasta barras, con herrajes de alta resistencia listos para instalación rápida.
                    </p>
                    <span class="inline-flex items-center justify-center bg-[#8a501c] text-white font-bold uppercase tracking-widest text-[0.8rem] px-6 py-3 rounded-none border border-[#0f1c28] transition-all duration-150 shadow-[6px_6px_0_0_#0f1c28] group-hover:bg-[#8a501c] group-hover:translate-x-[3px] group-hover:translate-y-[3px] group-hover:shadow-[3px_3px_0_0_#0f1c28] group-active:translate-x-[6px] group-active:translate-y-[6px] group-active:shadow-none w-fit">
                        Cotizar Cocinas
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </span>
                </div>
                <div class="w-full h-1 bg-outline-variant/20 relative mt-8">
                    <div class="absolute top-0 left-0 w-0 h-full bg-[#8a501c] transition-all duration-500 group-hover:w-full"></div>
                </div>
            </a>
            </div>

            <!-- Line 2: Closets -->
            <div class="w-full rounded-sm transform transition-all duration-1000 delay-200 ease-out reveal-card translate-y-32 opacity-0">
                <a href="/closets" data-shadow="shadow-[0_0.4em_0.1em_0.019em_#162839]" class="dynamic-card relative top-0 block h-full bg-[#162839]/5 hover:bg-[#162839]/10 p-10 border border-outline-variant/30 shadow-none transition-all duration-[500ms] group cursor-pointer flex flex-col justify-between hover:translate-y-[0.4em] hover:shadow-none hover:border-[#162839]/50">
                <div>
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-5xl font-black text-outline/30 group-hover:text-[#162839] transition-colors block">02</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="w-10 h-10 text-outline/40 group-hover:text-[#162839] transition-colors">
                            <rect x="3" y="3" width="18" height="18"></rect>
                            <line x1="12" y1="3" x2="12" y2="21"></line>
                            <line x1="3" y1="9" x2="12" y2="9"></line>
                            <line x1="3" y1="15" x2="12" y2="15"></line>
                            <line x1="12" y1="7" x2="21" y2="7"></line>
                            <line x1="16.5" y1="7" x2="16.5" y2="10"></line>
                        </svg>
                    </div>
                    <h4 class="text-2xl font-black uppercase mb-4 text-primary group-hover:text-[#162839] transition-colors">Clósets y Vestidores</h4>
                    <p class="text-on-surface-variant font-medium leading-relaxed mb-8">
                        Módulos de almacenamiento optimizados espacialmente. Diseños modulares adaptables a cualquier plano arquitectónico con acabados premium.
                    </p>
                    <span class="inline-flex items-center justify-center bg-[#162839] text-white font-bold uppercase tracking-widest text-[0.8rem] px-6 py-3 rounded-none border border-[#0f1c28] transition-all duration-150 shadow-[6px_6px_0_0_#0f1c28] group-hover:bg-[#162839] group-hover:translate-x-[3px] group-hover:translate-y-[3px] group-hover:shadow-[3px_3px_0_0_#0f1c28] group-active:translate-x-[6px] group-active:translate-y-[6px] group-active:shadow-none w-fit">
                        Cotizar Clósets
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </span>
                </div>
                <div class="w-full h-1 bg-outline-variant/20 relative mt-8">
                    <div class="absolute top-0 left-0 w-0 h-full bg-[#162839] transition-all duration-500 group-hover:w-full"></div>
                </div>
            </a>
            </div>

            <!-- Line 3: Puertas -->
            <div class="w-full rounded-sm transform transition-all duration-1000 delay-[400ms] ease-out reveal-card translate-y-32 opacity-0">
                <a href="/puertas" data-shadow="shadow-[0_0.4em_0.1em_0.019em_#8B3A36]" class="dynamic-card relative top-0 block h-full bg-[#8B3A36]/5 hover:bg-[#8B3A36]/10 p-10 border border-outline-variant/30 shadow-none transition-all duration-[500ms] group cursor-pointer flex flex-col justify-between hover:translate-y-[0.4em] hover:shadow-none hover:border-[#8B3A36]/50">
                <div>
                    <div class="flex justify-between items-start mb-6">
                        <span class="text-5xl font-black text-outline/30 group-hover:text-[#8B3A36] transition-colors block">03</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="w-10 h-10 text-outline/40 group-hover:text-[#8B3A36] transition-colors">
                            <rect x="5" y="3" width="14" height="18"></rect>
                            <rect x="7" y="5" width="10" height="16"></rect>
                            <line x1="14" y1="13" x2="15" y2="13"></line>
                        </svg>
                    </div>
                    <h4 class="text-2xl font-black uppercase mb-4 text-primary group-hover:text-[#8B3A36] transition-colors">Puertas</h4>
                    <p class="text-on-surface-variant font-medium leading-relaxed mb-8">
