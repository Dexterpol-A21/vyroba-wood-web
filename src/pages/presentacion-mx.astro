---
import Layout from '../layouts/Layout.astro';

const imageFiles = import.meta.glob<{ src: string }>(
	'../assets/presentacion/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
	{ eager: true, import: 'default' }
);
const videoFiles = import.meta.glob<string>(
	'../assets/presentacion/*.mp4',
	{ eager: true, import: 'default', query: '?url' }
);

function fileSrc(map: Record<string, { src: string } | string>, name: string) {
	const hit = Object.entries(map).find(([path]) => path.replaceAll('\\', '/').endsWith(`/${name}`));
	if (!hit) return '';
	const value = hit[1];
	return typeof value === 'string' ? value : value.src;
}

const groups = [
	{
		index: '01',
		kicker: 'Gran formato',
		title: 'Piso gráfico',
		text: 'Lona impresa, en instalación sobre el piso de la activación.',
		photos: ['piso-lona-loreal.jpeg'],
	},
	{
		index: '02',
		kicker: 'Gran formato',
		title: 'Muros y backdrops',
		text: 'Muro de marca en exterior y el mismo muro en montaje.',
		photos: ['backdrop-loreal-exterior.jpeg', 'muro-loreal-montaje.jpeg'],
	},
	{
		index: '03',
		kicker: 'Pieza fabricada',
		title: 'Barra',
		text: 'Barra blanca con cubierta morada, frente iluminado y paneles de campaña.',
		photos: ['barra-loreal-tu-lo-vales.jpeg', 'barra-loreal-detalle.jpeg'],
	},
	{
		index: '04',
		kicker: 'Activación',
		title: 'Stand',
		text: 'Stand armado, con mesas altas y el punto de marca al fondo.',
		photos: ['stand-loreal-mundo-hialuronico.jpeg'],
	},
	{
		index: '05',
		kicker: 'Mobiliario',
		title: 'Lounge',
		text: 'Mesas y sillas de la activación, frente a la pantalla y al muro de marca.',
		photos: ['lounge-pantalla-loreal.jpeg', 'mesas-sillas-loreal.jpeg', 'activacion-loreal-general.jpeg'],
	},
].map((group) => ({
	...group,
	shots: group.photos
		.map((name) => ({ src: fileSrc(imageFiles, name), alt: group.title }))
		.filter((shot) => shot.src),
}));

const clips = [
	{ file: 'piso-grafico-retrato.mp4', title: 'Piso gráfico, detalle', kicker: 'Video' },
	{ file: 'muro-siluetas.mp4', title: 'Muro de siluetas', kicker: 'Video' },
].map((clip) => ({ ...clip, src: fileSrc(videoFiles, clip.file) })).filter((clip) => clip.src);
---

<Layout
	bare
	robots="noindex, nofollow"
	title="Presentación | výroba"
	description="Presentación de producción Vyroba: piso gráfico, muros, barra, stand y lounge."
>
	<link slot="head" rel="icon" type="image/png" href="/presentacion/favicon-vyroba.png" />
	<link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
	<link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		slot="head"
		href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Montserrat:wght@400;500;600;700&display=swap"
		rel="stylesheet"
	/>
	<main class="deck" id="deck">
		<section class="slide is-on" data-slide>
			<header class="bar">
				<img src="/presentacion/logo-vyroba.png" alt="výroba" class="logo" width="72" height="68" />
				<span class="bar-meta">vyroba.mx</span>
			</header>
			<div class="cover-body">
				<p class="kicker">Producción desde 2014</p>
				<h1>El taller detrás de<br />la activación.</h1>
				<p class="lede">Piso gráfico, muros, barra y lounge.</p>
			</div>
			<footer class="bar end">
				<span>vyroba.mx</span>
				<span class="hint">Flechas para avanzar</span>
			</footer>
		</section>

		<section class="slide" data-slide>
			<header class="bar">
				<span class="kicker">Esta tanda</span>
				<span class="bar-meta">Activación</span>
			</header>
			<div class="bridge">
				<h2>No es el taller.<br /><span>Es la activación.</span></h2>
				<ul>
					{groups.map((group) => (
						<li>
							<span class="num">{group.index}</span>
							<span class="name">{group.title}</span>
							<span class="tag hot">{group.kicker}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		{groups.map((group) => (
			<section class="slide" data-slide>
				<header class="bar">
					<span class="kicker">{group.kicker}</span>
					<span class="bar-meta">{group.index}</span>
				</header>
				<div class:list={['chapter', group.shots.length > 0 && 'has-photos']}>
					<div class="copy">
						<p class="index">{group.index}</p>
						<h2>{group.title}</h2>
						<p>{group.text}</p>
					</div>
					<div class="mosaic" data-n={String(group.shots.length)}>
						{group.shots.map((photo) => (
							<figure>
								<img src={photo.src} alt={photo.alt} />
							</figure>
						))}
					</div>
				</div>
			</section>
		))}

		{clips.map((clip) => (
			<section class="slide" data-slide>
				<header class="bar">
					<span class="kicker">{clip.kicker}</span>
					<span class="bar-meta">{clip.title}</span>
				</header>
				<div class="chapter more has-photos">
					<p class="more-label">{clip.title}</p>
					<div class="mosaic" data-n="1">
						<figure>
							<video src={clip.src} controls muted playsinline preload="metadata"></video>
						</figure>
					</div>
				</div>
			</section>
		))}

		<section class="slide" data-slide>
			<header class="bar">
				<img src="/presentacion/logo-vyroba.png" alt="výroba" class="logo" width="72" height="68" />
				<span class="bar-meta">vyroba.mx</span>
			</header>
			<div class="cover-body">
				<h1>Ustedes activan.<br /><span>Nosotros producimos.</span></h1>
				<p class="lede">Piso gráfico · Muros · Barra · Stand · Lounge</p>
			</div>
			<footer class="bar end">
				<span>Vyroba</span>
				<span class="hint">Fin</span>
			</footer>
		</section>

		<div class="hud">
			<button type="button" id="prev" aria-label="Anterior">←</button>
			<span id="count">01</span>
			<button type="button" id="next" aria-label="Siguiente">→</button>
			<button type="button" id="full">Pantalla</button>
		</div>
	</main>
</Layout>

<script>
	const slides = Array.from(document.querySelectorAll('[data-slide]'));
	const count = document.getElementById('count');
	const deck = document.getElementById('deck');
	let index = 0;

	function pad(n) {
		return String(n).padStart(2, '0');
	}

	function show(next) {
		index = (next + slides.length) % slides.length;
		slides.forEach((slide, i) => slide.classList.toggle('is-on', i === index));
		if (count) count.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
	}

	function step(dir) {
		show(index + dir);
	}

	document.getElementById('next')?.addEventListener('click', () => step(1));
	document.getElementById('prev')?.addEventListener('click', () => step(-1));
	document.getElementById('full')?.addEventListener('click', () => {
		if (!document.fullscreenElement) document.documentElement.requestFullscreen();
		else document.exitFullscreen();
	});

	window.addEventListener('keydown', (event) => {
		const nextKeys = ['ArrowRight', 'ArrowDown', 'PageDown', ' '];
		const prevKeys = ['ArrowLeft', 'ArrowUp', 'PageUp'];
		if (nextKeys.includes(event.key)) {
			event.preventDefault();
			step(1);
		} else if (prevKeys.includes(event.key)) {
			event.preventDefault();
			step(-1);
		} else if (event.key === 'Home') {
			show(0);
		} else if (event.key === 'End') {
			show(slides.length - 1);
		} else if (event.key.toLowerCase() === 'f') {
			document.getElementById('full')?.click();
		}
	});

	let startX = 0;
	deck?.addEventListener('touchstart', (event) => {
		startX = event.changedTouches[0]?.clientX ?? 0;
	}, { passive: true });
	deck?.addEventListener('touchend', (event) => {
		const endX = event.changedTouches[0]?.clientX ?? startX;
		const delta = endX - startX;
		if (Math.abs(delta) > 40) step(delta < 0 ? 1 : -1);
	}, { passive: true });

	deck?.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element) || !deck) return;
		if (target.closest('.hud, video')) return;
		const rect = deck.getBoundingClientRect();
		const x = event.clientX - rect.left;
		step(x < rect.width * 0.22 ? -1 : 1);
	});

	show(0);
</script>

<style>
	.deck {
		height: 100dvh;
		background: #101010;
		color: #fbfbfb;
		font-family: 'Montserrat', sans-serif;
		position: relative;
	}
	.slide {
		display: none;
		height: 100dvh;
		padding: clamp(1.1rem, 2.4vw, 2rem) clamp(1.5rem, 4vw, 3.5rem) 5rem;
		flex-direction: column;
		gap: 1rem;
		box-sizing: border-box;
		overflow: hidden;
	}
	.slide.is-on { display: flex; }
	.bar, .end {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.68rem;
		font-weight: 600;
	}
	.logo { width: 3.4rem; height: auto; object-fit: contain; }
	.bar-meta, .hint { color: rgba(251, 251, 251, 0.55); }
	.kicker { color: #b19540; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; }
	.cover-body {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		max-width: min(18ch, 92vw);
		width: 100%;
	}
	h1, h2 {
		font-family: 'Libre Baskerville', serif;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.05;
		text-transform: none;
	}
	h1 { font-size: clamp(2.5rem, 6.2vw, 5.4rem); margin: 0.4rem 0 1rem; }
	h1 span, h2 span { color: #b19540; }
	.lede { max-width: 36ch; font-size: clamp(1.05rem, 1.6vw, 1.35rem); line-height: 1.35; color: rgba(251, 251, 251, 0.82); }
	.bridge {
		flex: 1;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
		margin: auto 0;
	}
	.bridge h2 {
		font-size: clamp(2.4rem, 4.8vw, 4.4rem);
		margin: 0;
		max-width: 10ch;
	}
	.bridge ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.bridge li {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: baseline;
		border-top: 1px solid rgba(251, 251, 251, 0.16);
		padding: 1rem 0;
		font-family: 'Libre Baskerville', serif;
		font-weight: 700;
		font-size: clamp(1.25rem, 1.9vw, 1.75rem);
		letter-spacing: -0.01em;
		text-transform: none;
	}
	.bridge li:last-child { border-bottom: 1px solid rgba(251, 251, 251, 0.16); }
	.num, .tag { font-family: 'Montserrat', sans-serif; font-size: 0.68rem; letter-spacing: 0.14em; color: rgba(251, 251, 251, 0.5); font-weight: 600; text-transform: uppercase; }
	.tag.hot { color: #b19540; }
	.chapter {
		flex: 1;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		align-items: stretch;
	}
	.chapter.more { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
	.index {
		font-family: 'Libre Baskerville', serif;
		font-weight: 700;
		font-size: clamp(3rem, 6vw, 5rem);
		line-height: 0.8;
		color: rgba(251, 251, 251, 0.18);
		margin: 0 0 0.5rem;
	}
	.copy h2 { font-size: clamp(2.4rem, 4.8vw, 4.2rem); margin: 0 0 1rem; }
	.copy p:last-child { max-width: 34ch; font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.4; color: rgba(251, 251, 251, 0.84); }
	.more-label {
		font-family: 'Montserrat', sans-serif;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #b19540;
	}
	.mosaic { display: grid; gap: 0.55rem; min-height: 0; height: 100%; }
	.mosaic[data-n="1"] { grid-template-columns: 1fr; }
	.mosaic[data-n="2"] { grid-template-columns: 1fr 1fr; }
	.mosaic[data-n="3"],
	.mosaic[data-n="4"] { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
	.mosaic figure { margin: 0; overflow: hidden; background: #000; min-height: 0; }
	.mosaic img, .mosaic video { width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
	.empty {
		border: 1px dashed rgba(177, 149, 64, 0.7);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.6rem;
		padding: 1.5rem;
		color: rgba(251, 251, 251, 0.72);
	}
	.empty code {
		color: #b19540;
		font-size: 0.95rem;
		word-break: break-all;
	}
	.hud {
		position: fixed;
		right: clamp(1rem, 3vw, 2.5rem);
		bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		z-index: 5;
	}
	.hud button, #count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: #fbfbfb;
		border: 1px solid rgba(251, 251, 251, 0.28);
		min-height: 2.2rem;
		min-width: 2.2rem;
		padding: 0 0.75rem;
		font: inherit;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		cursor: pointer;
		box-sizing: border-box;
		white-space: nowrap;
		line-height: 1;
	}
	#count {
		min-width: 5.5rem;
		cursor: default;
		pointer-events: none;
	}
	.hud button:hover { background: #b19540; color: #101010; border-color: #b19540; }
	@media (max-width: 860px) {
		.bridge, .chapter { grid-template-columns: 1fr; }
		.cover-body { max-width: none; }
		h1 { font-size: clamp(2.2rem, 10vw, 3.4rem); }
	}
</style>
