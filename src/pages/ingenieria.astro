---
import Layout from '../layouts/Layout.astro';
import DraftingGrid from '../components/grids/DraftingGrid';
---

<Layout 
	title="Ingeniería y Manufactura Avanzada | Vyroba Wood" 
	description="Descubre nuestra metodología BIM y cómo utilizamos maquinaria CNC automatizada para transformar madera e insumos arquitectónicos B2B con la máxima eficiencia."
	keywords="planta industrial de muebles, ruteadora cnc, cantadora scm, tecnologia panel, optimizacion bim, madera ingenierizada, vyroba wood"
>
    <!-- Usamos el fondo del index -->
    <main class="min-h-screen pt-32 pb-24 border-b-[16px] border-primary relative">

        <DraftingGrid client:load />

        <!-- Hero con estilo Blueprint de Mando Control -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-24 lg:flex justify-between items-end border-b border-primary/20 pb-16 relative z-10">
            <div class="max-w-4xl">
                <div class="inline-block px-3 py-1 bg-primary text-[0.65rem] font-bold text-surface tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#8a501c] mb-8">
                    OPERACIONES B2B
                </div>
                <h1 class="text-5xl md:text-[6vw] font-black font-cabinet uppercase tracking-tighter text-primary leading-[0.85] mb-6">
                    MANU<br/><span class="text-secondary">FACTURA</span><br/>JUST-IN-TIME
                </h1>
                <p class="text-xl max-w-2xl font-satoshi text-on-surface-variant font-medium leading-relaxed">
                    Sincronización total entre tu avance de obra civil y nuestra línea de producción. Capacidad industrial instalada de más de +500 unidades simultáneas.
                </p>
            </div>
            <div class="mt-12 lg:mt-0 font-mono text-xs text-primary/60 max-w-xs text-left lg:text-right tracking-widest uppercase leading-loose border-l lg:border-r lg:border-l-0 border-primary/20 pl-6 lg:pr-6">
                <p class="flex justify-between lg:justify-end gap-8 mb-2"><span>PLANT STATUS:</span> <strong class="text-primary">ONLINE</strong></p>
                <p class="flex justify-between lg:justify-end gap-8 mb-2"><span>TOL. CORTE:</span> <strong class="text-primary">0.05MM</strong></p>
                <p class="flex justify-between lg:justify-end gap-8"><span>CICLO VOL.:</span> <strong class="text-primary">ALTO</strong></p>
            </div>
        </section>

        <!-- Pipeline Operativo -->
        <section class="px-6 md:px-12 max-w-[1600px] mx-auto relative z-10">
            
            <!-- PIPELINE HEADER -->
            <div class="w-full bg-primary text-surface p-6 flex flex-col md:flex-row md:items-center justify-between shadow-[8px_8px_0_0_#8a501c]">
                <h2 class="text-3xl font-black font-cabinet uppercase tracking-tighter">EL PIPELINE (BIM ➔ SITIO)</h2>
                <span class="font-mono text-[0.65rem] uppercase tracking-widest text-surface/50 mt-4 md:mt-0">Diagrama Operacional</span>
            </div>

            <!-- FASES GRID -->
            <div class="grid grid-cols-1 lg:grid-cols-3 mt-12 gap-8 lg:gap-0 lg:border-t-2 border-primary/20">
                
                <!-- FASE 01 -->
                <div class="lg:border-r-2 border-b-2 lg:border-b-0 border-primary/20 pt-8 lg:pr-12 relative group hover:-translate-y-2 transition-transform duration-300">
                    <span class="text-[5rem] font-black text-primary/10 absolute top-4 left-0 leading-none group-hover:text-primary/20 transition-colors">01</span>
                    <h3 class="text-2xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4 relative z-10">Ingesta Planos / BIM</h3>
                    <p class="text-sm font-satoshi text-on-surface-variant font-medium leading-relaxed relative z-10 mb-6">
                        Auditoría geométrica de los planos arquitectónicos del desarrollador. Nuestros ingenieros introducen las cuotas exactas a nuestro software CAD/CAM nativo para asegurar colisiones cero con muretes.
                    </p>
                    <div class="h-px w-16 bg-secondary mb-4"></div>
                    <span class="font-mono text-[0.65rem] uppercase text-primary/60 tracking-widest font-bold">» PARÁMETROS FIJADOS</span>
                </div>

                <!-- FASE 02 -->
                <div class="lg:border-r-2 border-b-2 lg:border-b-0 border-primary/20 pt-8 lg:px-12 relative group hover:-translate-y-2 transition-transform duration-300">
                    <span class="text-[5rem] font-black text-primary/10 absolute top-4 left-6 lg:left-12 leading-none group-hover:text-primary/20 transition-colors">02</span>
                    <h3 class="text-2xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4 relative z-10">Maquinado Constante</h3>
                    <p class="text-sm font-satoshi text-on-surface-variant font-medium leading-relaxed relative z-10 mb-6">
                        El código de diseño (G-Code) viaja de los servidores directo a las sierras de panel seccionadoras y centros de ruteo europeos de 5 ejes, abatiendo fallas de intervención humana. Perforación system 32 a milímetro.
                    </p>
                    <div class="h-px w-16 bg-secondary mb-4"></div>
                    <span class="font-mono text-[0.65rem] uppercase text-primary/60 tracking-widest font-bold">» CORTES EN CADENA</span>
                </div>

                <!-- FASE 03 -->
                <div class="pt-8 lg:pl-12 relative group hover:-translate-y-2 transition-transform duration-300">
                    <span class="text-[5rem] font-black text-primary/10 absolute top-4 left-6 lg:left-12 leading-none group-hover:text-secondary/20 transition-colors">03</span>
                    <h3 class="text-2xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4 relative z-10">Canteado y Flat-Pack</h3>
                    <p class="text-sm font-satoshi text-on-surface-variant font-medium leading-relaxed relative z-10 mb-6">
                        Recubrimiento de testas mediante extrusión de poliuretano (PUR). Inmediatamente los paneles pasan a estación de logística: Etiquetado individual de partes para despiece RTA (Ready-to-Assemble) y paletizado térmico por zona de obra.
                    </p>
                    <div class="h-px w-16 bg-secondary mb-4"></div>
                    <span class="font-mono text-[0.65rem] uppercase text-primary/60 tracking-widest font-bold">» DESPACHO A TORRE</span>
                </div>

            </div>
        </section>

        <!-- SECCIÓN SEO: CAPACIDAD TÉCNICA Y MAQUINARIA -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mt-32 relative z-10">
            <div class="mb-12 border-b border-primary/20 pb-6">
                <div class="inline-block px-3 py-1 bg-surface border border-primary/20 text-[0.65rem] font-bold text-primary tracking-[0.2em] uppercase mb-4 shadow-[4px_4px_0_0_#162839]">
                    CAPACIDADES B2B
                </div>
                <h2 class="text-3xl md:text-5xl font-black font-cabinet uppercase tracking-tighter text-primary">Carpintería Industrial y Tecnología de Procesamiento</h2>
                <p class="text-lg md:text-xl font-satoshi text-on-surface-variant max-w-4xl mt-6 leading-relaxed">
                    Nuestra planta está equipada para resolver los desafíos de <strong>fabricación de mobiliario y carpintería para desarrollos inmobiliarios, hotelería y grandes corporativos</strong>. Elevamos la esencia de la madera mediante procesos de <strong>carpintería a escala b2b</strong>. Esto significa que cada proyecto de <a href="/cocinas" class="text-primary hover:text-secondary underline decoration-2 underline-offset-4">cocinas integrales</a>, <a href="/closets" class="text-primary hover:text-secondary underline decoration-2 underline-offset-4">clósets a medida</a> y puertas de madera está respaldado por tecnología que respeta el material mientras garantiza una manufactura impecable y repetible.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Ruteo y Corte -->
                <div class="bg-surface-dim border border-outline-variant/30 p-8 hover:shadow-[8px_8px_0_0_#162839] transition-all duration-300">
                    <h3 class="text-xl font-black font-cabinet uppercase text-primary mb-3">Corte Automatizado de Tableros y Maderas</h3>
                    <p class="text-base text-on-surface-variant leading-relaxed">
                        Transformamos altos volúmenes de <strong>maderas de ingeniería y tableros recubiertos (melaminas, MDF, encinos, nogales)</strong> maximizando el rendimiento del material. Nuestra tecnología de seccionado asegura que cada veta y patrón cuadre perfectamente, entregando paneles de madera dimensionados milimétricamente listos para ensamblar.
                    </p>
                </div>
                
                <!-- Canteado -->
                <div class="bg-surface-dim border border-outline-variant/30 p-8 hover:shadow-[8px_8px_0_0_#162839] transition-all duration-300">
                    <h3 class="text-xl font-black font-cabinet uppercase text-primary mb-3">Enchapado de Cantos para Mobiliario</h3>
                    <p class="text-base text-on-surface-variant leading-relaxed">
                        Protegemos y damos acabado a la madera expuesta utilizando adhesivos de alta resistencia (PUR/EVA). Aplicamos cintillas perimetrales, chapas de madera natural o cantos encolados que fusionan estética y durabilidad, protegiendo <strong>módulos de cocinas</strong> o <strong>muebles residenciales</strong> de la humedad ambiental y el desgaste.
                    </p>
                </div>

                <!-- Perforación Múltiple -->
                <div class="bg-surface-dim border border-outline-variant/30 p-8 hover:shadow-[8px_8px_0_0_#162839] transition-all duration-300">
                    <h3 class="text-xl font-black font-cabinet uppercase text-primary mb-3">Perforación y Ensambles Especializados</h3>
                    <p class="text-base text-on-surface-variant leading-relaxed">
                        Combinamos los principios de la buena carpintería con barrenado múltiple para la inserción perfecta de herrajes (bisagras ocultas de cierre lento, guías y taquetes de madera). Este mecanizado garantiza que cada una de tus <a href="/puertas" class="text-primary hover:text-secondary underline decoration-2 underline-offset-4">puertas de intercomunicación de madera</a> y cajoneras funcionen con una escuadra impecable a través de los años.
                    </p>
                </div>
            </div>
        </section>

        <!-- VIDEOS PLANTA -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mt-32 relative z-10">
            <div class="mb-12 border-b-2 border-primary/20 pb-4 flex justify-between items-end">
                <h2 class="text-4xl md:text-5xl font-black font-cabinet uppercase tracking-tighter text-primary">PLANTA EN OPERACIÓN</h2>
                <span class="font-mono text-xs text-secondary font-bold tracking-widest uppercase hidden md:inline-block">CAPACIDAD INSTALADA</span>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
                <!-- Video 1 -->
                <div class="border-[2px] border-primary bg-surface p-2 shadow-[8px_8px_0_0_#162839] hover:-translate-y-2 hover:shadow-[16px_16px_0_0_#162839] transition-all duration-300">
                    <div class="aspect-video w-full">
                        <iframe class="w-full h-full" src="https://www.youtube.com/embed/SAaSUmFZcPY?si=CWEG6kPBSXVfAFBm" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                    <div class="py-4 px-2 border-t-2 border-primary mt-2">
                        <p class="font-mono text-xs tracking-widest text-primary/70 uppercase">Corte automatizado en panel de alta densidad</p>
                    </div>
                </div>
                
                <!-- Video 2 -->
                <div class="border-[2px] border-primary bg-surface p-2 shadow-[8px_8px_0_0_#162839] hover:-translate-y-2 hover:shadow-[16px_16px_0_0_#162839] transition-all duration-300">
                    <div class="aspect-video w-full">
                        <iframe class="w-full h-full" src="https://www.youtube.com/embed/PZ3dMFppuR8?si=z_yz3f02dYTY-xKj" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                    <div class="py-4 px-2 border-t-2 border-primary mt-2">
                        <p class="font-mono text-xs tracking-widest text-primary/70 uppercase">Ruteo CNC de alta precisión en tiempo real</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCION: PROTOCOLO FAQ OPERATIVO -->
        <section id="faq" class="w-full bg-surface-dim border-t border-primary mt-24 py-24 relative z-10">
            <div class="px-6 md:px-12 w-full max-w-[1000px] mx-auto">
                <div class="mb-16 text-center">
                    <span class="inline-block px-3 py-1 bg-surface border border-primary/20 text-[0.65rem] font-bold text-primary mb-6 tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839]">
                        FAQ TÉCNICO
                    </span>
                    <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-primary font-cabinet mb-4">
                        Preguntas de Ingeniería
                    </h2>
                </div>

                <div class="space-y-4">
                    <!-- FAQ 1: Tolerancias -->
                    <details class="bg-surface border border-primary/20 shadow-[4px_4px_0_0_#162839] group open:shadow-none hover:shadow-none transition-all duration-300">
                        <summary class="flex justify-between items-center cursor-pointer p-6 font-black uppercase tracking-wide text-primary text-sm list-none select-none">
                            ¿Qué nivel de tolerancia de corte garantizan?      
                            <span class="text-secondary group-open:rotate-45 transition-transform duration-300">+</span>
                        </summary>
                        <div class="p-6 pt-0 border-t border-primary/10 text-on-surface-variant text-sm leading-relaxed mt-2 bg-surface">
                            Gracias a nuestra maquinaria europea CNC, mantenemos tolerancias industriales de ±0.05 milímetros. Evitamos problemas de instalación de raíz.
                        </div>
                    </details>

                    <!-- FAQ 2: BIM -->
                    <details class="bg-surface border border-primary/20 shadow-[4px_4px_0_0_#162839] group open:shadow-none hover:shadow-none transition-all duration-300">
                        <summary class="flex justify-between items-center cursor-pointer p-6 font-black uppercase tracking-wide text-primary text-sm list-none select-none">
                            ¿Trabajan directamente con mis archivos BIM/CAD?
                            <span class="text-secondary group-open:rotate-45 transition-transform duration-300">+</span>
                        </summary>
                        <div class="p-6 pt-0 border-t border-primary/10 text-on-surface-variant text-sm leading-relaxed mt-2 bg-surface">
                            Por supuesto. Nuestro proceso incluye la ingesta directa de sus archivos arquitectónicos, validando medidas exactas antes de generar el G-Code final de corte.
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section id="contacto" class="w-full bg-primary text-surface py-24 border-t border-secondary relative overflow-hidden z-10">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-secondary/10 transform skew-x-[-15deg] origin-bottom-right z-0"></div>
            <div class="px-6 md:px-12 w-full max-w-[1600px] mx-auto relative z-10 text-center flex flex-col items-center">

                <h2 class="text-5xl md:text-[6vw] font-black uppercase tracking-tighter leading-[0.9] text-surface font-cabinet mb-8 max-w-4xl">
                    Solicita <span class="text-secondary">Producción</span>.       
                </h2>

                <p class="text-lg text-surface/70 font-medium leading-[1.4] mb-12 max-w-xl">
                    Envíanos los planos y requerimientos técnicos de tu desarrollo para un plan de maquinado exacto.
                </p>

                <a href="mailto:info@vyroba.com.mx" class="cursor-pointer bg-secondary border border-secondary text-primary px-10 py-6 font-black uppercase tracking-[0.2em] text-[0.8rem] md:text-sm shadow-[8px_8px_0_0_#1a1c1c] hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-[4px_4px_0_0_#1a1c1c] hover:bg-primary-container hover:text-surface hover:border-primary-container active:translate-x-[8px] active:translate-y-[8px] active:shadow-none transition-all duration-150 inline-flex items-center justify-center">
                    <span>Enviar Planos de Ingeniería</span>
                </a>

                <div class="mt-8 flex gap-6 text-[0.65rem] font-bold tracking-[0.1em] text-surface/40 uppercase">
                    <span>+ INFO +52 55 3645 1199</span>
                    <span>|</span>
                    <span>INFO@VYROBA.COM.MX</span>
                </div>
            </div>
        </section>

    </main>
</Layout>