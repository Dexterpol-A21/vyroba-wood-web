---
import Layout from '../layouts/Layout.astro';
import DraftingGrid from '../components/grids/DraftingGrid';
---

<Layout 
	title="Materialoteca e Insumos Estructurales | Vyroba Wood" 
	description="Catálogo de núcleo: sustratos, recubrimientos (HPL, melaminas), y herrajes kinéticos diseñados para proyectos de carpintería y mobiliario masivo."
	keywords="melamina termoestructural, tableros arauco, herrajes hettich, panel hdf, recubrimiento pet, materialoteca vyroba wood, mdf alta densidad"
>
    <main class="min-h-screen pt-32 pb-24 border-b-[8px] border-primary relative">
        <DraftingGrid client:load />
        
        <!-- Hero Section -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-24 overflow-hidden flex flex-col lg:flex-row lg:items-stretch justify-between gap-12 lg:gap-16">
            <div class="relative z-10 flex flex-col justify-start">
                <div class="inline-block px-3 py-1 bg-surface border border-primary/20 text-[0.65rem] font-bold text-primary tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839] mb-8 w-max">
                    CATÁLOGO DE ESPECIFICACIONES
                </div>
                <h1 class="text-6xl md:text-[8vw] font-black font-cabinet uppercase tracking-tighter text-primary leading-[0.8] mb-0">
                    MATE<br/>RIALO<br/><span class="text-secondary">TECA</span>
                </h1>
            </div>
            
            <div class="border border-primary bg-surface px-8 py-6 md:px-12 md:py-8 shadow-[8px_8px_0_0_#162839] w-fit max-w-3xl relative z-10 flex flex-col justify-center hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300">
                <span class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-secondary mb-4 block">Enfoque Técnico</span>
                <p class="text-lg md:text-2xl font-satoshi text-on-surface-variant font-medium leading-[1.4]">
                    No seleccionamos colores; prescribimos soluciones de ingeniería. Nuestro inventario de sustratos y recubrimientos está clasificado por densidad, tensión estructural y resistencia a factores físicos.
                </p>
            </div>
        </section>

        <!-- Spec Grid 01: SUSTRATOS Y NÚCLEOS -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-32">
            <h2 class="text-2xl font-bold font-cabinet uppercase tracking-widest text-primary border-b-2 border-primary/20 pb-4 mb-12 flex justify-between items-end">
                <span>01. Sustratos y Núcleos</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Item 1: Sustrato MDF -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/5 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">MDF-RH</span>
                        <div class="absolute top-4 right-4 bg-primary text-surface px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#8a501c]">
                            NÚCLEO
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">MD / RH Alta Densidad</h3>
                        
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">DENSIDAD (NOM)</span>
                                <span class="font-mono text-primary font-bold text-sm">720 KG/M³</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">ESPESOR ESTR.</span>
                                <span class="font-mono text-primary font-bold text-sm">15 / 18MM</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Item 2: MDP -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/5 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">MDP</span>
                        <div class="absolute top-4 right-4 bg-primary text-surface px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#8a501c]">
                            NÚCLEO
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">MDP Estructural</h3>
                        
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">DENSIDAD (NOM)</span>
                                <span class="font-mono text-primary font-bold text-sm">680 KG/M³</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">TRACCIÓN TORN.</span>
                                <span class="font-mono text-primary font-bold text-sm">> 800 N</span>
                            </div>
                        </div>
                    </div>
                </article>
                
                <!-- Item 3: Plywood -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/5 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">PLY</span>
                        <div class="absolute top-4 right-4 bg-primary text-surface px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#8a501c]">
                            NÚCLEO
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">Plywood Marino</h3>
                        
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">ADHESIVO</span>
                                <span class="font-mono text-primary font-bold text-sm">FENÓLICO WBP</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">USO</span>
                                <span class="font-mono text-primary font-bold text-sm">ALTA HUMEDAD</span>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <!-- Spec Grid 02: RECUBRIMIENTOS Y LAMINADOS -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-32">
            <h2 class="text-2xl font-bold font-cabinet uppercase tracking-widest text-primary border-b-2 border-primary/20 pb-4 mb-12 flex justify-between items-end">
                <span>02. Recubrimientos Visibles</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Item 1: Recubrimiento PET -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/10 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">PET</span>
                        <div class="absolute top-4 right-4 bg-secondary text-primary px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#162839]">
                            SUPERFICIE
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">PET Supermate</h3>
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">REFLECTANCIA</span>
                                <span class="font-mono text-primary font-bold text-sm">< 3 GLOSS</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">UNIÓN CANTO</span>
                                <span class="font-mono text-primary font-bold text-sm">LÁSER / PUR</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Item 2: Superficies Sólidas / Piedra -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/10 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">QZ</span>
                        <div class="absolute top-4 right-4 bg-secondary text-primary px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#162839]">
                            CUBIERTA TÉCNICA
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">Cuarzo Sinterizado</h3>
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">DUREZA MOHS</span>
                                <span class="font-mono text-primary font-bold text-sm">7 / 10</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">ABSORCIÓN</span>
                                <span class="font-mono text-primary font-bold text-sm">0.02%</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Item 3: Detalles y Acentos Metal -->
                <article class="border border-primary bg-surface hover:-translate-y-2 hover:shadow-[12px_12px_0_0_#162839] transition-all duration-300 flex flex-col h-full group">
                    <div class="aspect-square bg-primary/10 w-full border-b border-primary relative overflow-hidden flex items-center justify-center">
                        <span class="text-primary/10 font-black text-6xl uppercase tracking-tighter group-hover:scale-110 transition-transform duration-500">AL</span>
                        <div class="absolute top-4 right-4 bg-secondary text-primary px-2 py-1 text-[0.6rem] font-mono uppercase tracking-widest shadow-[2px_2px_0_0_#162839]">
                            ACENTO
                        </div>
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-xl font-black font-cabinet uppercase text-primary tracking-tighter mb-4">Aluminio Anodizado</h3>
                        <div class="grid grid-cols-2 gap-4 border-t border-primary/10 pt-4 flex-1">
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">ALEACIÓN</span>
                                <span class="font-mono text-primary font-bold text-sm">6063 T5</span>
                            </div>
                            <div>
                                <span class="block text-[0.6rem] uppercase tracking-widest text-primary/50 font-bold mb-1">REVESTIMIENTO</span>
                                <span class="font-mono text-primary font-bold text-sm">ANODIZADO 15μ</span>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <!-- MATERIALOTECA CTA -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 relative overflow-hidden">
            <div class="w-full bg-secondary text-primary py-24 px-8 md:px-16 border border-primary shadow-[12px_12px_0_0_#162839] relative">
                <!-- Decorative Graphic -->
                <div class="absolute top-0 left-0 w-1/3 h-full bg-surface/10 transform skew-x-[-15deg] origin-bottom-left z-0"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-12">
                    <div class="max-w-2xl">
                        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter leading-[0.9] text-primary font-cabinet mb-6">
                            COTIZA BAJO <span class="text-surface">ESPECIFICACIONES</span>
                        </h2>
                        <p class="text-lg text-primary/80 font-medium leading-[1.4]">
                            Obtén la matriz de costos basada en volumen de sustrato y recubrimiento para tu proyecto arquitectónico.
                        </p>
                    </div>
                    
                    <a href="mailto:info@vyroba.com.mx" class="cursor-pointer bg-primary border border-primary text-surface px-10 py-6 font-black uppercase tracking-[0.2em] text-[0.8rem] md:text-sm shadow-[6px_6px_0_0_#f9f9f9] hover:translate-x-[6px] hover:translate-y-[6px] hover:shadow-none transition-all duration-150 whitespace-nowrap">
                        <span>SOLICITAR MUESTRAS FÍSICAS</span>
                    </a>
                </div>
            </div>
        </section>

    </main>
</Layout>