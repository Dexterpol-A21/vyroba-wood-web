---
import Layout from '../layouts/Layout.astro';
import DraftingGrid from '../components/grids/DraftingGrid';
---

<Layout 
	title="Contacto | Vyroba Wood"
	description="Contacta a Vyroba Wood para cotizar cocinas, clósets y puertas a medida. WhatsApp, correo info@vyroba.com.mx y teléfono +52 56 2131 0456."
	keywords="contacto vyroba wood, cotizar mobiliario, cotizar cocinas, cotizar closets, whatsapp vyroba, info@vyroba.com.mx"
>
    <main class="min-h-screen pt-8 lg:pt-32 pb-24 border-b-[8px] border-primary relative">
        <DraftingGrid client:load />

        <!-- Hero -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-12 lg:mb-20 relative z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-10">
            <div>
                <div class="inline-block px-3 py-1 bg-surface border border-primary/20 text-[0.65rem] font-bold text-primary tracking-[0.2em] uppercase shadow-[4px_4px_0_0_#162839] mb-8 w-max">
                    CANAL DIRECTO B2B
                </div>
                <h1 class="text-6xl md:text-[7vw] font-black font-cabinet uppercase tracking-tighter text-primary leading-[0.85]">
                    CON<br/><span class="text-secondary">TACTO</span>
                </h1>
            </div>
            <p class="text-lg md:text-xl max-w-xl font-satoshi text-on-surface-variant font-medium leading-relaxed">
                Envía requerimientos de tu desarrollo o residencial. Respondemos con alcance técnico y plan de maquinado.
            </p>
        </section>

        <!-- Canales rápidos -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 mb-12 lg:mb-16 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <a href="https://wa.me/525621310456" target="_blank" rel="noopener noreferrer" class="border border-[#1ebe57] bg-[#25D366] p-6 md:p-8 shadow-[4px_4px_0_0_#128C7E] hover:bg-[#1ebe57] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#128C7E] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all duration-150 flex flex-col gap-4 group">
                    <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/80">01 // WhatsApp</span>
                    <span class="text-2xl font-black font-cabinet uppercase text-white tracking-tight">Escribir ahora</span>
                    <span class="text-sm text-white/90 font-medium mt-auto">+52 56 2131 0456</span>
                </a>
                <a href="mailto:info@vyroba.com.mx" class="border border-secondary bg-secondary p-6 md:p-8 shadow-[4px_4px_0_0_#162839] hover:bg-[#8B5520] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#162839] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all duration-150 flex flex-col gap-4 group">
                    <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/80">02 // Correo</span>
                    <span class="text-2xl font-black font-cabinet uppercase text-white tracking-tight">Enviar planos</span>
                    <span class="text-sm text-white/90 font-medium mt-auto">info@vyroba.com.mx</span>
                </a>
                <a href="tel:+525621310456" class="border border-primary bg-primary p-6 md:p-8 shadow-[4px_4px_0_0_#C17A2F] hover:bg-primary-container hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#C17A2F] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all duration-150 flex flex-col gap-4 group">
                    <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-secondary">03 // Teléfono</span>
                    <span class="text-2xl font-black font-cabinet uppercase text-white tracking-tight">Llamar</span>
                    <span class="text-sm text-white/90 font-medium mt-auto">+52 56 2131 0456</span>
                </a>
            </div>
        </section>

        <!-- Formulario + info -->
        <section class="max-w-[1600px] mx-auto px-6 md:px-12 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
                
                <!-- Form -->
                <div class="lg:col-span-7 border border-primary bg-surface shadow-[8px_8px_0_0_#162839] p-6 md:p-10">
                    <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Formulario de cotización</span>
                    <h2 class="text-3xl md:text-4xl font-black font-cabinet uppercase tracking-tighter text-primary mb-8">
                        Cuéntanos el proyecto
                    </h2>

                    <form
                        id="contact-form"
                        class="flex flex-col gap-5"
                        action="https://formsubmit.co/info@vyroba.com.mx"
                        method="POST"
                    >
                        <!-- FormSubmit config -->
                        <input type="hidden" name="_subject" value="Nueva cotización — Vyroba Wood" />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="_captcha" value="false" />
                        <input type="hidden" name="_next" value="https://vyroba.com.mx/contacto?enviado=1" />
                        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

                        <div id="form-success" class="hidden border border-secondary bg-secondary/10 p-4 text-sm font-medium text-primary">
                            Solicitud enviada. Te contactamos pronto.
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <label class="flex flex-col gap-2">
                                <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Nombre</span>
                                <input type="text" name="nombre" required autocomplete="name" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all" placeholder="Tu nombre" />
                            </label>
                            <label class="flex flex-col gap-2">
                                <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Empresa / Desarrolladora</span>
                                <input type="text" name="empresa" autocomplete="organization" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all" placeholder="Opcional" />
                            </label>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <label class="flex flex-col gap-2">
                                <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Correo</span>
                                <input type="email" name="email" required autocomplete="email" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all" placeholder="correo@empresa.com" />
                            </label>
                            <label class="flex flex-col gap-2">
                                <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Teléfono</span>
                                <input type="tel" name="telefono" autocomplete="tel" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all" placeholder="+52 ..." />
                            </label>
                        </div>

                        <label class="flex flex-col gap-2">
                            <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Línea de interés</span>
                            <select name="linea" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all appearance-none cursor-pointer">
                                <option value="Cocinas">Cocinas</option>
                                <option value="Clósets">Clósets</option>
                                <option value="Puertas">Puertas</option>
                                <option value="Proyecto integral">Proyecto integral</option>
                            </select>
                        </label>

                        <label class="flex flex-col gap-2">
                            <span class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-primary/50">Mensaje / alcance</span>
                            <textarea name="mensaje" required rows="5" class="w-full bg-surface-container-low border border-primary/20 px-4 py-3 text-primary font-satoshi text-sm focus:outline-none focus:border-primary focus:shadow-[3px_3px_0_0_#162839] transition-all resize-y min-h-[120px]" placeholder="Volumen aproximado, ubicación, plazos, si tienes planos BIM/CAD..."></textarea>
                        </label>

                        <button type="submit" class="cursor-pointer mt-2 bg-primary border border-primary text-surface px-8 py-5 font-black uppercase tracking-[0.15em] text-[0.75rem] shadow-[6px_6px_0_0_#C17A2F] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0_0_#C17A2F] active:shadow-none active:translate-x-[6px] active:translate-y-[6px] transition-all duration-150 inline-flex items-center justify-center w-full sm:w-auto">
                            Enviar solicitud
                        </button>
                    </form>
                </div>

                <!-- Side info -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    <div class="border border-primary bg-primary text-surface p-6 md:p-8 shadow-[8px_8px_0_0_#C17A2F]">
                        <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Qué incluir</span>
                        <ul class="space-y-4 text-sm font-medium leading-relaxed text-surface/80">
                            <li class="flex gap-3"><span class="text-secondary font-black">→</span> Tipo de proyecto (residencial, torre, hotel)</li>
                            <li class="flex gap-3"><span class="text-secondary font-black">→</span> Cantidad aproximada de módulos / unidades</li>
                            <li class="flex gap-3"><span class="text-secondary font-black">→</span> Planos BIM / CAD si ya los tienes</li>
                            <li class="flex gap-3"><span class="text-secondary font-black">→</span> Fecha objetivo de entrega en obra</li>
                        </ul>
                    </div>

                    <div class="border border-primary bg-surface p-6 md:p-8">
                        <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Horario de respuesta</span>
                        <p class="text-primary font-cabinet font-black text-xl uppercase tracking-tight mb-2">Lun — Vie</p>
                        <p class="text-on-surface-variant text-sm font-medium">Respuesta típica en horario hábil. Para urgencias de obra, WhatsApp es el canal más rápido.</p>
                    </div>

                    <a href="https://wa.me/525621310456?text=Hola%20Vyroba%2C%20quiero%20cotizar%20un%20proyecto." target="_blank" rel="noopener noreferrer" class="cursor-pointer bg-[#25D366] border border-[#1ebe57] text-white px-8 py-5 font-black uppercase tracking-[0.15em] text-[0.75rem] shadow-[6px_6px_0_0_#128C7E] hover:bg-[#1ebe57] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0_0_#128C7E] active:translate-x-[6px] active:translate-y-[6px] active:shadow-none transition-all duration-150 inline-flex items-center justify-center text-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        Abrir WhatsApp
                    </a>
                </div>
            </div>
        </section>
    </main>

    <script>
        // Mostrar mensaje de éxito tras redirect de FormSubmit
        if (new URLSearchParams(window.location.search).get('enviado') === '1') {
            const success = document.getElementById('form-success');
            if (success) {
                success.classList.remove('hidden');
                success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // En local: redirect de vuelta a localhost tras envío
        const next = document.querySelector('input[name="_next"]');
        if (next && window.location.hostname === 'localhost') {
            next.setAttribute('value', `${window.location.origin}/contacto?enviado=1`);
        }
    </script>
</Layout>
