---
import Layout from '../layouts/Layout.astro';
import DraftingGrid from '../components/grids/DraftingGrid';
---

<Layout 
	title="Clósets y Vestidores | Vyroba Wood"
	description="Producción y diseño de clósets y vestidores empotrados de grado industrial. Alta resistencia, ergonomía espacial y herrajes premium para B2B."
	keywords="closets a medida, vestidores de madera, armarios industriales, carpinteria grandes proyectos, herrajes hettich, vyroba wood closets"
>
  <main class="relative">
    <DraftingGrid client:load theme="closets" />

    <!-- HERO SECTION: CLOSETS -->
    <section class="relative z-10 min-h-[70vh] pt-[120px] pb-12 px-6 md:px-12 flex flex-col justify-end border-b border-outline-variant/20 bg-[#162839]/5">
      <div class="max-w-[1600px] mx-auto w-full relative z-10">
        <div class="mb-8">
            <span class="text-5xl font-black text-outline/30 block mb-4">02</span>
            <h2 class="font-bold tracking-[0.2em] text-xs uppercase text-[#162839] mb-4 block">Líneas B2B</h2>   
            <h1 class="text-6xl md:text-[8vw] font-black uppercase tracking-tighter leading-[0.9] text-primary font-cabinet">
                Clósets y<br/>Vestidores
            </h1>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12 items-end">
            <p class="text-xl md:text-2xl text-on-surface-variant font-medium leading-[1.3] max-w-2xl">
                Estructuras de almacenamiento vertical optimizadas geométricamente. Módulos que aprovechan la arquitectura subyacente para maximizar el uso espacial del desarrollo corporativo o residencial.
            </p>
            <div class="flex justify-start md:justify-end gap-4">
                <a href="#contacto" class="inline-flex items-center justify-center bg-primary text-white font-bold border border-[#0f1c28] uppercase tracking-widest text-sm px-8 py-4 rounded-none transition-all duration-150 shadow-[8px_8px_0_0_#0f1c28] hover:bg-[#8a501c] hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-[4px_4px_0_0_#0f1c28] active:translate-x-[8px] active:translate-y-[8px] active:shadow-none whitespace-nowrap">
                    Cotizar Proyecto
                </a>
            </div>
        </div>
      </div>
    </section>

    <!-- SPECIFICATIONS / TECHNICAL DETAILS -->
    <section class="py-24 px-6 md:px-12 border-b border-outline-variant/20 relative z-10 w-full overflow-hidden bg-surface">
      <div class="max-w-[1600px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          
          <!-- Details Left -->
          <div>
            <h3 class="text-3xl font-black uppercase text-primary mb-8 font-cabinet">Arquitectura de Interiores</h3>
            <p class="text-lg text-on-surface-variant font-medium leading-relaxed mb-8">
              Aprovechamiento espacial masivo mediante componentes ajustables y modulación paramétrica. En desarrollos de cientos de unidades, la velocidad de montaje es crucial; proveemos gabinetes autoportantes, listos para conectar y anclar directamente al muro seco.
            </p>
            
            <!-- Features List -->
            <div class="space-y-6">
              <div class="border-l-2 border-[#162839] pl-6">
                <h4 class="text-xl font-bold text-primary uppercase">Escalabilidad Modular</h4>
                <p class="text-on-surface-variant mt-2 text-sm">Bloques y subensambles intercambiables diseñados bajo grillas paramétricas B2B.</p>
              </div>
              <div class="border-l-2 border-[#162839] pl-6">
                <h4 class="text-xl font-bold text-primary uppercase">Carga Repartida</h4>
                <p class="text-on-surface-variant mt-2 text-sm">Refuerzo estructural superior para colgado de ropa que previene panceo central.</p>
              </div>
              <div class="border-l-2 border-[#162839] pl-6">
                <h4 class="text-xl font-bold text-primary uppercase">Hardware Oculto</h4>
                <p class="text-on-surface-variant mt-2 text-sm">Mecanismo de sujeción integrado, el cual evita tornillería visible al interior del vestidor.</p>
              </div>
            </div>
          </div>

          <!-- Graphic / Tech Spec Visual -->
          <div class="bg-surface-container border border-outline-variant/30 p-12 flex flex-col justify-center items-center relative group">
             <!-- Technical grid background -->
             <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none z-0"></div>
             
             <!-- Center Technical SVG -->
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="-100 -10 320 120" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="square" class="w-full max-w-[700px] h-auto overflow-visible text-primary/50 relative z-10 transition-colors duration-500 group-hover:text-[#162839]">

                <!-- MAIN WARDROBE SYSTEM ELEVATION -->
                <!-- Base Frame -->
                <rect x="10" y="10" width="60" height="80" stroke-width="1"></rect>
                
                <!-- Vertical Divisions -->
                <line x1="30" y1="10" x2="30" y2="90"></line>
                <line x1="50" y1="10" x2="50" y2="90"></line>

                <!-- Left Section: Sub-shelves & Short Hang -->
                <line x1="10" y1="20" x2="30" y2="20" stroke-width="0.7"></line>
                <line x1="12" y1="24" x2="28" y2="24" stroke-width="1.5"></line> <!-- Metal Rod 1 -->
                <!-- Hanger Graphics -->
                <path d="M14 24 L14 27 L12 32 L16 32 Z" stroke-width="0.2"></path>
                <path d="M18 24 L18 27 L16 32 L20 32 Z" stroke-width="0.2"></path>

                <!-- Mid-shelf -->
                <line x1="10" y1="55" x2="30" y2="55" stroke-width="0.7"></line>
                <line x1="12" y1="59" x2="28" y2="59" stroke-width="1.5"></line> <!-- Metal Rod 2 -->
                <path d="M22 59 L22 62 L20 67 L24 67 Z" stroke-width="0.2"></path>

                <!-- Middle Section: Fixed Shelves & Drawer Banks -->
                <line x1="30" y1="25" x2="50" y2="25"></line>
                <line x1="30" y1="40" x2="50" y2="40"></line>
                <line x1="30" y1="55" x2="50" y2="55" stroke-width="1"></line> <!-- Main Drawer Counter -->
                
                <!-- Drawer Bank -->
                <rect x="31" y="57" width="18" height="8" fill="currentColor" fill-opacity="0.05"></rect>
                <line x1="37" y1="61" x2="43" y2="61"></line>
                <rect x="31" y="66" width="18" height="8" fill="currentColor" fill-opacity="0.05"></rect>
                <line x1="37" y1="70" x2="43" y2="70"></line>
                <rect x="31" y="75" width="18" height="10" fill="currentColor" fill-opacity="0.05"></rect>
                <line x1="37" y1="80" x2="43" y2="80"></line>

                <!-- Right Section: Long Hang (Coats/Dresses) & Shoe Rack -->
                <line x1="50" y1="15" x2="70" y2="15"></line>
                <line x1="52" y1="19" x2="68" y2="19" stroke-width="1.5"></line>
                <!-- Dress Graphic -->
                <path d="M60 19 L60 22 L55 50 L65 50 Z" stroke-width="0.3"></path>

                <!-- Shoe Rack Slots -->
                <line x1="50" y1="65" x2="70" y2="67"></line>
                <line x1="50" y1="75" x2="70" y2="77"></line>
                <line x1="50" y1="85" x2="70" y2="87"></line>

                <!-- SYSTEM 32 IND HOLE PATTERN CALLOUT -->
                <!-- Callout Line -->
                <circle cx="48" cy="30" r="3" stroke-dasharray="1 1"></circle>
                <line x1="51" y1="30" x2="75" y2="30" stroke-width="0.3"></line>
                
                <!-- Zoom Circle Background -->
                <circle cx="85" cy="30" r="10" fill="white"></circle>
                <circle cx="85" cy="30" r="10"></circle>
                <!-- Zoom internal grid -->
                <line x1="80" y1="20" x2="80" y2="40" stroke-width="0.2" stroke-dasharray="1 1"></line>
                <!-- 32mm pin holes -->
                <circle cx="82" cy="24" r="0.8" fill="currentColor"></circle>
                <circle cx="82" cy="30" r="0.8" fill="currentColor"></circle>
                <circle cx="82" cy="36" r="0.8" fill="currentColor"></circle>
                <circle cx="88" cy="24" r="0.8" fill="currentColor"></circle>
                <!-- Technical Note -->
                <text x="85" y="45" font-family="monospace" font-size="2.5" text-anchor="middle" fill="currentColor" stroke="none">SYS-32 IND</text>

                <!-- WIDTH DIMENSION -->
                <line x1="10" y1="95" x2="70" y2="95" stroke-width="0.3"></line>
                <line x1="10" y1="93" x2="10" y2="97" stroke-width="0.3"></line>
                <line x1="70" y1="93" x2="70" y2="97" stroke-width="0.3"></line>
                <text x="40" y="98" font-family="monospace" font-size="2.5" text-anchor="middle" fill="currentColor" stroke="none">3 x 600mm MODULES</text>

                <!-- ADVANCED CALLOUTS (INDUSTRIAL B2B METRICS) -->
                <!-- Callout 1: Herrajes (Hardware) -->
                <circle cx="34" cy="59" r="1.5" fill="currentColor" stroke="none"></circle>
                <line x1="34" y1="59" x2="15" y2="40" stroke-width="0.3" stroke-dasharray="1 1"></line>
                <line x1="15" y1="40" x2="-20" y2="40" stroke-width="0.3"></line>
                <text x="-25" y="42" font-family="monospace" font-size="6" font-weight="bold" text-anchor="end" fill="currentColor" stroke="none">MODULACIÓN ESPACIAL</text>

                <!-- Callout 2: Acabados (Finishes) -->
                <circle cx="65" cy="15" r="1.5" fill="currentColor" stroke="none"></circle>
                <line x1="65" y1="15" x2="80" y2="10" stroke-width="0.3" stroke-dasharray="1 1"></line>
                <line x1="80" y1="10" x2="120" y2="10" stroke-width="0.3"></line>
                <text x="125" y="12" font-family="monospace" font-size="6" font-weight="bold" text-anchor="start" fill="currentColor" stroke="none">MATERIALES SUPERIORES</text>

                <!-- Callout 3: Madera/Núcleo (Core/Wood) -->
                <circle cx="15" cy="80" r="1.5" fill="currentColor" stroke="none"></circle>
                <line x1="15" y1="80" x2="5" y2="65" stroke-width="0.3" stroke-dasharray="1 1"></line>
                <line x1="5" y1="65" x2="-20" y2="65" stroke-width="0.3"></line>
                <text x="-25" y="67" font-family="monospace" font-size="6" font-weight="bold" text-anchor="end" fill="currentColor" stroke="none">DETALLES IMPECABLES</text>

              </svg>
              
              <div class="absolute bottom-6 right-6 font-mono text-xs font-bold text-outline uppercase tracking-widest">
                FIG. A-V / VOLÚMENES DE VESTIDOR
              </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- IMPLEMENTATION GALLERY -->
    <section class="py-24 px-6 md:px-12 border-b border-outline-variant/20 relative z-10 w-full bg-transparent">
      <div class="max-w-[1600px] mx-auto">
        <!-- Section Header -->
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2 class="text-sm font-bold tracking-[0.2em] text-[#8B3A36] uppercase mb-4">Registro Operativo</h2>
            <h3 class="text-4xl md:text-5xl font-black uppercase text-primary font-cabinet">Galería de Implementación</h3>
          </div>
          <div class="hidden md:block text-right">
            <p class="text-sm font-mono text-outline font-bold">REF // G-003</p>
          </div>
        </div>

        <!-- Gallery Grid (Blueprint placeholders) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-l border-t border-outline-variant/20 auto-rows-fr">
          
          <!-- Image Placeholder 1 (BENTO LARGE - Diagram to Render) -->
          <div class="md:col-span-2 md:row-span-2 relative group border-r border-b border-outline-variant/20 bg-white overflow-hidden cursor-crosshair min-h-[400px] md:min-h-0">
            <!-- Default State: The Blueprint/Diagram -->
            <picture class="contents">
  <source srcset="/images/closet/closetDiagram.avif" type="image/avif" />
  <source srcset="/images/closet/closetDiagram.webp" type="image/webp" />
  <img src="/images/closet/closetDiagram.png" alt="Closet Plan" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0" />
</picture>
            <!-- Hover State: The Real Render -->
            <picture class="contents">
  <source srcset="/images/closet/closetRender.avif" type="image/avif" />
  <source srcset="/images/closet/closetRender.webp" type="image/webp" />
  <img src="/images/closet/closetRender.png" alt="Closet Render" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100" />
</picture>
            <!-- Technical label (disappears on hover) -->
            <div class="absolute bottom-4 left-4 font-mono text-xs text-primary/70 font-bold opacity-100 group-hover:opacity-0 transition-opacity duration-300">FIG 01 // ESQUEMA Y RENDER</div>
          </div>

          <!-- PROMPT 1 -->
          <div class="aspect-square relative group border-r border-b border-outline-variant/20 bg-surface-container overflow-hidden cursor-crosshair">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:10px_10px] opacity-100 z-0"></div>
            <!-- BASE IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset1.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset1.webp" type="image/webp" />
  <img src="/images/closet/renderCloset1.png" alt="Nordic Closet Scene" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0 z-0" />
</picture>
            <!-- HOVER IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset1B.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset1B.webp" type="image/webp" />
  <img src="/images/closet/renderCloset1B.png" alt="Nordic Closet Hover" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100 z-0" />
</picture>
          </div>

          <!-- PROMPT 2 -->
          <div class="aspect-square relative group border-r border-b border-outline-variant/20 bg-surface-container overflow-hidden cursor-crosshair">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:10px_10px] opacity-100 z-0"></div>
            <!-- BASE IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset2.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset2.webp" type="image/webp" />
  <img src="/images/closet/renderCloset2.png" alt="Brutalism Closet Scene" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0 z-0" />
</picture>
            <!-- HOVER IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset2B.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset2B.webp" type="image/webp" />
  <img src="/images/closet/renderCloset2B.png" alt="Brutalism Closet Hover" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100 z-0" />
</picture>
          </div>

          <!-- PROMPT 3 -->
          <div class="aspect-square relative group border-r border-b border-outline-variant/20 bg-surface-container overflow-hidden cursor-crosshair">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:10px_10px] opacity-100 z-0"></div>
            <!-- BASE IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset3.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset3.webp" type="image/webp" />
  <img src="/images/closet/renderCloset3.png" alt="Monolith Closet Scene" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0 z-0" />
</picture>
            <!-- HOVER IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset3B.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset3B.webp" type="image/webp" />
  <img src="/images/closet/renderCloset3B.png" alt="Monolith Closet Hover" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100 z-0" />
</picture>
          </div>

          <!-- PROMPT 4 -->
          <div class="aspect-square relative group border-r border-b border-outline-variant/20 bg-surface-container overflow-hidden cursor-crosshair">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:10px_10px] opacity-100 z-0"></div>
            <!-- BASE IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset4.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset4.webp" type="image/webp" />
  <img src="/images/closet/renderCloset4.png" alt="Warm Nat Closet Scene" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0 z-0" />
</picture>
            <!-- HOVER IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset4B.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset4B.webp" type="image/webp" />
  <img src="/images/closet/renderCloset4B.png" alt="Warm Nat Closet Hover" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100 z-0" />
</picture>
          </div>

          <!-- PROMPT 5 -->
          <div class="aspect-square relative group border-r border-b border-outline-variant/20 bg-surface-container overflow-hidden cursor-crosshair">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(22,40,57,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(22,40,57,0.05)_1px,transparent_1px)] bg-[size:10px_10px] opacity-100 z-0"></div>
            <!-- BASE IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset5.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset5.webp" type="image/webp" />
  <img src="/images/closet/renderCloset5.png" alt="Gallery Closet Scene" class="absolute inset-0 w-full h-full object-cover object-center opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0 z-0" />
</picture>
            <!-- HOVER IMAGE -->
            <picture class="contents">
  <source srcset="/images/closet/renderCloset5B.avif" type="image/avif" />
  <source srcset="/images/closet/renderCloset5B.webp" type="image/webp" />
  <img src="/images/closet/renderCloset5B.png" alt="Gallery Closet Hover" class="absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100 z-0" />
</picture>
        </div>
      </div>
    </section>

    <script is:inline>
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const text = btn.getAttribute('data-prompt');
          if(text) {
            navigator.clipboard.writeText(text).then(() => {
              const originalHtml = btn.innerHTML;
              btn.innerHTML = '✅ COPIADO';
              setTimeout(() => { btn.innerHTML = originalHtml; }, 2000);
            }).catch(err => console.error('Error al copiar:', err));
          }
        });
      });
    </script>
    <!-- CTA Final -->
    <section id="contacto" class="w-full bg-primary text-surface py-32 border-t border-secondary relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-secondary/10 transform skew-x-[-15deg] origin-bottom-right z-0"></div>
        <div class="px-6 md:px-12 w-full max-w-[1600px] mx-auto relative z-10 text-center flex flex-col items-center">
            <h2 class="text-5xl md:text-[6vw] font-black uppercase tracking-tighter leading-[0.9] text-surface font-cabinet mb-8 max-w-4xl">
                Inicia tu <span class="text-secondary">Producción</span>.
            </h2>
            <p class="text-lg text-surface/70 font-medium leading-[1.4] mb-12 max-w-xl">
                Envía los requerimientos BIM/CAD de tu desarrollo o residencial. Evaluaremos las especificaciones y responderemos con un plan de maquinado exacto.
            </p>
            <a href="mailto:info@vyroba.com.mx" class="cursor-pointer bg-secondary border border-secondary text-primary px-10 py-6 font-black uppercase tracking-[0.2em] text-[0.8rem] md:text-sm shadow-[8px_8px_0_0_#1a1c1c] hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-[4px_4px_0_0_#1a1c1c] hover:bg-primary-container hover:text-surface hover:border-primary-container active:translate-x-[8px] active:translate-y-[8px] active:shadow-none transition-all duration-150 inline-flex items-center justify-center">
                <span>Enviar Planos y Requerimientos</span>
            </a>
            <div class="mt-8 flex gap-6 text-[0.65rem] font-bold tracking-[0.1em] text-surface/40 uppercase">
                <span>+ INFO +52 55 3645 1199</span>
                <span>|</span>
                <span>INFO@VYROBA.COM.MX</span>
            </div>
        </div>
    </section>
  </main>
</Layout>